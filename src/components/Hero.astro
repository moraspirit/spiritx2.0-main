---
import CosmicCanvas from './CosmicCanvas.astro';
import Navigation from './Navigation.astro';
import SpaceHUD from './SpaceHUD.astro';
import ScreenWipes from './ScreenWipes.astro';
import FlybyActors from './FlybyActors.astro';

import SplashSection from './sections/SplashSection.astro';
import HomeSection from './sections/HomeSection.astro';
import AboutSection from './sections/AboutSection.astro';
import TracksSection from './sections/TracksSection.astro';
import CtaSection from './sections/CtaSection.astro';
---

<script>
  import '@google/model-viewer';
</script>

<script>
  import Lenis from 'lenis';

  const initHeroOrchestrator = () => {
    const stageEl = document.getElementById('stage') as HTMLElement;
    const globalNav = document.getElementById('global-nav') as HTMLElement;
    const spaceHud = document.getElementById('space-hud') as HTMLElement;
    const hudAltitude = document.getElementById('hud-altitude') as HTMLElement;
    const hudGForce = document.getElementById('hud-gforce') as HTMLElement;
    const hudSector = document.getElementById('hud-sector') as HTMLElement;
    const hudReticle = document.getElementById('hud-reticle') as HTMLElement;

    const shuttleActor = document.getElementById('shuttle-actor') as HTMLElement;
    const astronautActor = document.getElementById('astronaut-actor') as HTMLElement;
    const shuttleWipe = document.getElementById('shuttle-wipe') as HTMLElement;
    const astronautWipe = document.getElementById('astronaut-wipe') as HTMLElement;

    const layers = Array.from(document.querySelectorAll('.layer')) as HTMLElement[];
    const trackCards = Array.from(document.querySelectorAll('.track-card')) as HTMLElement[];
    const navLinks = Array.from(document.querySelectorAll('.nav-links a')) as HTMLAnchorElement[];

    if (!stageEl || layers.length === 0) return;

    // -----------------------------------------------------------
    // 1. Lenis Smooth Scroll Engine
    // -----------------------------------------------------------
    const lenis = new Lenis({
      duration: 1.25,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
    });

    let currentScroll = 0;
    let scrollVelocity = 0;

    lenis.on('scroll', (e) => {
      currentScroll = e.scroll;
      scrollVelocity = e.velocity || 0;
    });

    // -----------------------------------------------------------
    // 2. Mouse Tracking for Parallax & Visor HUD
    // -----------------------------------------------------------
    const mouse = { x: 0, y: 0, targetX: 0, targetY: 0, rawX: 0, rawY: 0 };

    window.addEventListener('mousemove', (e) => {
      mouse.rawX = e.clientX;
      mouse.rawY = e.clientY;
      mouse.targetX = (e.clientX / window.innerWidth) * 2 - 1;
      mouse.targetY = -(e.clientY / window.innerHeight) * 2 + 1;
    });

    window.addEventListener('mouseleave', () => {
      mouse.targetX = 0;
      mouse.targetY = 0;
    });

    // -----------------------------------------------------------
    // 3. Spatial Layer Engine & World Transition Orchestrator
    // -----------------------------------------------------------
    let smoothProgress = 0;
    let targetProgress = 0;
    let lastActiveIndex = -1;
    let frameCount = 0;

    const updateSpatialLayers = () => {
      frameCount++;
      const scrollMax = document.documentElement.scrollHeight - window.innerHeight;
      targetProgress = scrollMax > 0 ? (currentScroll / scrollMax) * (layers.length - 1) : 0;
      smoothProgress += (targetProgress - smoothProgress) * 0.085;

      // Mouse stage tilt
      mouse.x += (mouse.targetX - mouse.x) * 0.04;
      mouse.y += (mouse.targetY - mouse.y) * 0.04;

      const tiltX = -mouse.y * 3.5;
      const tiltY = mouse.x * 3.5;
      stageEl.style.transform = `rotateX(${tiltX.toFixed(2)}deg) rotateY(${tiltY.toFixed(2)}deg)`;

      // Dynamic Theme Switcher based on current world
      let activeWorld = 'cyber';
      if (smoothProgress >= 1.35 && smoothProgress < 2.45) {
        activeWorld = 'alien';
      } else if (smoothProgress >= 2.45) {
        activeWorld = 'solar';
      }
      document.body.setAttribute('data-world', activeWorld);

      // =========================================================
      // FLYBY ACTOR 1: TRANSPARENT SPACE SHUTTLE (Progress 0.85 -> 1.7)
      // Swoops across screen, expands to cover 100% of viewport, and wipes into World 2
      // =========================================================
      if (shuttleActor) {
        if (smoothProgress >= 0.85 && smoothProgress <= 1.7) {
          const t = (smoothProgress - 0.85) / 0.85; // 0 to 1
          shuttleActor.style.visibility = 'visible';

          // Parabolic trajectory from top-left to bottom-right
          const x = -45 + t * 95; // -45vw to +50vw
          const y = -55 + t * 115; // -55vh to +60vh
          // Scale peaks at t = 0.55 (progress ~1.35) -> covers full screen!
          const scale = 0.85 + Math.sin(t * Math.PI) * 3.5;
          const rot = -24 + t * 18;

          shuttleActor.style.transform = `translate(calc(-50% + ${x.toFixed(1)}vw), calc(-50% + ${y.toFixed(1)}vh)) rotate(${rot.toFixed(1)}deg) scale(${scale.toFixed(2)})`;

          const op = Math.min(1, Math.sin(t * Math.PI) * 1.8);
          shuttleActor.style.opacity = op.toFixed(3);

          // Shutter screen wipe at peak occlusion (t = 0.55)
          if (shuttleWipe) {
            const wipeDist = Math.abs(t - 0.55);
            if (wipeDist < 0.22) {
              const wOp = Math.pow(1 - wipeDist / 0.22, 2) * 0.95;
              shuttleWipe.style.opacity = wOp.toFixed(3);
            } else {
              shuttleWipe.style.opacity = '0';
            }
          }
        } else {
          shuttleActor.style.visibility = 'hidden';
          shuttleActor.style.opacity = '0';
          if (shuttleWipe) shuttleWipe.style.opacity = '0';
        }
      }

      // =========================================================
      // FLYBY ACTOR 2: TRANSPARENT GIANT ASTRONAUT (Progress 1.95 -> 2.85)
      // Drifts across screen from right to left, gold visor covers 100% of viewport, wipes into World 3
      // =========================================================
      if (astronautActor) {
        if (smoothProgress >= 1.95 && smoothProgress <= 2.85) {
          const t = (smoothProgress - 1.95) / 0.9; // 0 to 1
          astronautActor.style.visibility = 'visible';

          // Drifting zero-G trajectory from right to left
          const x = 50 - t * 105; // 50vw to -55vw
          const y = -12 + t * 30; // -12vh to +18vh
          // Scale peaks at t = 0.5 (progress ~2.4) -> visor covers full screen!
          const scale = 0.9 + Math.sin(t * Math.PI) * 3.8;
          const rot = 10 - t * 20;

          astronautActor.style.transform = `translate(calc(-50% + ${x.toFixed(1)}vw), calc(-50% + ${y.toFixed(1)}vh)) rotate(${rot.toFixed(1)}deg) scale(${scale.toFixed(2)})`;

          const op = Math.min(1, Math.sin(t * Math.PI) * 1.8);
          astronautActor.style.opacity = op.toFixed(3);

          // Shutter screen wipe at peak occlusion (t = 0.5)
          if (astronautWipe) {
            const wipeDist = Math.abs(t - 0.5);
            if (wipeDist < 0.22) {
              const aOp = Math.pow(1 - wipeDist / 0.22, 2) * 0.95;
              astronautWipe.style.opacity = aOp.toFixed(3);
            } else {
              astronautWipe.style.opacity = '0';
            }
          }
        } else {
          astronautActor.style.visibility = 'hidden';
          astronautActor.style.opacity = '0';
          if (astronautWipe) astronautWipe.style.opacity = '0';
        }
      }

      // Update Cosmic Three.js Canvas (Worlds 1, 2, 3)
      if (typeof (window as any).__updateCosmicCanvas === 'function') {
        (window as any).__updateCosmicCanvas(smoothProgress, scrollVelocity, mouse);
      }

      // Nav bar visibility
      if (globalNav) {
        if (smoothProgress > 0.35) globalNav.classList.add('nav-visible');
        else globalNav.classList.remove('nav-visible');
      }

      // Active nav link
      const activeIndex = Math.round(smoothProgress);
      if (activeIndex !== lastActiveIndex) {
        lastActiveIndex = activeIndex;
        navLinks.forEach((link) => {
          const target = link.getAttribute('data-target');
          if (target && parseInt(target, 10) === activeIndex) {
            link.classList.add('active');
          } else {
            link.classList.remove('active');
          }
        });
      }

      // Visor Cockpit HUD updates
      if (spaceHud) {
        const hudOpacity = Math.max(0, Math.min(1, (smoothProgress - 0.8) / 0.5));
        spaceHud.style.opacity = (hudOpacity * 0.88).toFixed(2);
        spaceHud.style.pointerEvents = hudOpacity > 0.5 ? 'auto' : 'none';

        if (hudAltitude) {
          const descentKm = Math.max(0, (4 - smoothProgress) * 12500);
          hudAltitude.textContent = `${descentKm.toLocaleString('en-US', { maximumFractionDigits: 0 })} KM`;
        }

        if (hudGForce) {
          const g = Math.abs(scrollVelocity) * 0.11;
          hudGForce.textContent = `${g.toFixed(2)} G`;
        }

        if (hudSector) {
          if (smoothProgress < 1.35) hudSector.textContent = 'SECTOR 01 // CYBER ORBIT';
          else if (smoothProgress < 2.45) hudSector.textContent = 'SECTOR 02 // EXOPLANET ANOTHER EARTH';
          else hudSector.textContent = 'SECTOR 03 // SOLAR CITADEL & SUN';
        }

        if (hudReticle) {
          hudReticle.style.transform = `translate(${mouse.rawX}px, ${mouse.rawY}px)`;
        }
      }

      // Non-repetitive layer spatial choreography
      layers.forEach((layer, i) => {
        const delta = smoothProgress - i;

        if (Math.abs(delta) > 1.35) {
          layer.style.opacity = '0';
          layer.style.visibility = 'hidden';
          layer.style.pointerEvents = 'none';
          return;
        }

        layer.style.visibility = 'visible';

        if (i === 0) {
          // Splash: Forward dive
          const t = Math.max(0, delta);
          const z = t * 900;
          const blur = Math.min(16, t * 14);
          const opacity = Math.max(0, 1 - Math.pow(t / 0.85, 1.6));
          layer.style.transform = `translate3d(0, 0, ${z.toFixed(1)}px)`;
          layer.style.filter = blur > 0.2 ? `blur(${blur.toFixed(1)}px)` : 'none';
          layer.style.opacity = opacity.toFixed(3);
          layer.style.pointerEvents = delta < 0.25 ? 'auto' : 'none';
        } else if (i === 1) {
          // Home: Accelerates into Shuttle Flyby
          if (delta < 0) {
            const u = -delta;
            const p = Math.pow(u, 1.25);
            const z = -p * 1700;
            const y = p * 40;
            const blur = Math.min(14, p * 11);
            const opacity = Math.max(0, 1 - Math.pow(u / 1.05, 1.45));
            layer.style.transform = `translate3d(0, ${y.toFixed(1)}px, ${z.toFixed(1)}px)`;
            layer.style.filter = blur > 0.2 ? `blur(${blur.toFixed(1)}px)` : 'none';
            layer.style.opacity = opacity.toFixed(3);
          } else {
            const v = delta;
            const z = v * 1050;
            const blur = Math.min(18, v * 15);
            const opacity = Math.max(0, 1 - Math.pow(v / 0.8, 1.8));
            layer.style.transform = `translate3d(0, 0, ${z.toFixed(1)}px)`;
            layer.style.filter = blur > 0.2 ? `blur(${blur.toFixed(1)}px)` : 'none';
            layer.style.opacity = opacity.toFixed(3);
          }
          layer.style.pointerEvents = Math.abs(delta) < 0.25 ? 'auto' : 'none';
        } else if (i === 2) {
          // About: Descends onto Another Earth Biosphere
          if (delta < 0) {
            const u = -delta;
            const p = Math.pow(u, 1.3);
            const z = -p * 1800;
            const rotZ = u * 16;
            const blur = Math.min(14, p * 11);
            const opacity = Math.max(0, 1 - Math.pow(u / 1.05, 1.45));
            layer.style.transform = `translate3d(0, 0, ${z.toFixed(1)}px) rotateZ(${rotZ.toFixed(1)}deg)`;
            layer.style.filter = blur > 0.2 ? `blur(${blur.toFixed(1)}px)` : 'none';
            layer.style.opacity = opacity.toFixed(3);
          } else {
            const v = delta;
            const z = v * 950;
            const blur = Math.min(16, v * 13);
            const opacity = Math.max(0, 1 - Math.pow(v / 0.82, 1.6));
            layer.style.transform = `translate3d(0, 0, ${z.toFixed(1)}px)`;
            layer.style.filter = blur > 0.2 ? `blur(${blur.toFixed(1)}px)` : 'none';
            layer.style.opacity = opacity.toFixed(3);
          }
          layer.style.pointerEvents = Math.abs(delta) < 0.25 ? 'auto' : 'none';
        } else if (i === 3) {
          // Tracks: Solar Citadel Zero-G Satellite Cards
          if (delta < 0) {
            const u = -delta;
            const p = Math.pow(u, 1.25);
            const z = -p * 1750;
            const blur = Math.min(14, p * 11);
            const opacity = Math.max(0, 1 - Math.pow(u / 1.05, 1.45));
            layer.style.transform = `translate3d(0, 0, ${z.toFixed(1)}px)`;
            layer.style.filter = blur > 0.2 ? `blur(${blur.toFixed(1)}px)` : 'none';
            layer.style.opacity = opacity.toFixed(3);

            trackCards.forEach((card, cIdx) => {
              const dirX = cIdx % 2 === 0 ? -1 : 1;
              const dirY = cIdx < 2 ? -1 : 1;
              const cardOffset = u * 130;
              card.style.transform = `translate3d(${(dirX * cardOffset).toFixed(1)}px, ${(dirY * cardOffset * 0.7).toFixed(1)}px, ${(-cardOffset * 2).toFixed(1)}px)`;
            });
          } else {
            const v = delta;
            const z = v * 950;
            const blur = Math.min(16, v * 13);
            const opacity = Math.max(0, 1 - Math.pow(v / 0.82, 1.6));
            layer.style.transform = `translate3d(0, 0, ${z.toFixed(1)}px)`;
            layer.style.filter = blur > 0.2 ? `blur(${blur.toFixed(1)}px)` : 'none';
            layer.style.opacity = opacity.toFixed(3);
          }

          if (Math.abs(delta) < 0.25) {
            trackCards.forEach((card, cIdx) => {
              const floatY = Math.sin(frameCount * 0.03 + cIdx * 1.2) * 6;
              const floatRot = Math.cos(frameCount * 0.02 + cIdx) * 1.2;
              card.style.transform = `translate3d(0, ${floatY.toFixed(1)}px, 0) rotateZ(${floatRot.toFixed(1)}deg)`;
            });
          }
          layer.style.pointerEvents = Math.abs(delta) < 0.25 ? 'auto' : 'none';
        } else if (i === 4) {
          // CTA: Arrival at Sun & Earth Gateway
          if (delta < 0) {
            const u = -delta;
            const p = Math.pow(u, 1.28);
            const z = -p * 1800;
            const blur = Math.min(14, p * 11);
            const opacity = Math.max(0, 1 - Math.pow(u / 1.05, 1.45));
            layer.style.transform = `translate3d(0, 0, ${z.toFixed(1)}px)`;
            layer.style.filter = blur > 0.2 ? `blur(${blur.toFixed(1)}px)` : 'none';
            layer.style.opacity = opacity.toFixed(3);
          } else {
            layer.style.transform = `translate3d(0, 0, 0)`;
            layer.style.filter = 'none';
            layer.style.opacity = '1';
          }
          layer.style.pointerEvents = Math.abs(delta) < 0.35 ? 'auto' : 'none';
        }
      });
    };

    // -----------------------------------------------------------
    // 4. Anchor Link Navigation
    // -----------------------------------------------------------
    const scrollTargets: Record<string, number> = {
      '#home': 1,
      '#about': 2,
      '#tracks': 3,
      '#cta': 4,
    };

    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        const href = anchor.getAttribute('href');
        if (href && scrollTargets[href] !== undefined) {
          e.preventDefault();
          const targetIndex = scrollTargets[href];
          const scrollMax = document.documentElement.scrollHeight - window.innerHeight;
          const dest = (targetIndex / (layers.length - 1)) * scrollMax;

          lenis.scrollTo(dest, {
            duration: 1.45,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          });
        }
      });
    });

    // -----------------------------------------------------------
    // 5. Master Animation Loop
    // -----------------------------------------------------------
    const masterLoop = (time: number) => {
      lenis.raf(time);
      updateSpatialLayers();
      requestAnimationFrame(masterLoop);
    };

    requestAnimationFrame(masterLoop);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroOrchestrator);
  } else {
    initHeroOrchestrator();
  }
</script>

<!-- 3D Three.js Cosmic Canvas (World 1, 2, 3) -->
<CosmicCanvas />

<!-- Screen-filling Occlusion Shutter Wipes -->
<ScreenWipes />

<!-- Transparent Space Shuttle & Astronaut Flyby Image Actors -->
<FlybyActors />

<!-- Astronaut / Space Shuttle Visor Flight Deck HUD -->
<SpaceHUD />

<!-- Persistent Floating Navigation Bar -->
<Navigation />

<!-- Ambient Cosmic Glow Background Lights -->
<div class="ambient-glows" aria-hidden="true">
  <div class="glow-orb orb-1"></div>
  <div class="glow-orb orb-2"></div>
  <div class="glow-orb orb-3"></div>
</div>

<!-- 3D Perspective Stage Viewport -->
<div class="stage-viewport">
  <div class="stage" id="stage">
    <!-- Modular Section Layers -->
    <SplashSection />
    <HomeSection />
    <AboutSection />
    <TracksSection />
    <CtaSection />
  </div>
</div>

<!-- Virtual Scroll Track for 3D Camera Travel (500vh) -->
<div class="scroll-range" aria-hidden="true"></div>

<style>
  /* -----------------------------------------------------------
     Dynamic World Themes & Global Variables
     ----------------------------------------------------------- */
  :root {
    --bg: #0a0a12;
    --panel: #11111e;
    --border: rgba(255, 255, 255, 0.08);
    --border-glow: rgba(139, 92, 246, 0.35);
    --text: #f4f4f8;
    --muted: #9a9aae;
    --grad: linear-gradient(135deg, #8b5cf6 0%, #ec4899 50%, #06b6d4 100%);
    --grad-glow: linear-gradient(90deg, #8b5cf6, #ec4899);
    --radius-sm: 10px;
    --radius-md: 18px;
    --radius-lg: 28px;
    transition: --grad 0.5s ease;
  }

  /* WORLD 2: ALIEN EARTH / BIOSPHERE */
  :global(body[data-world="alien"]) {
    --border-glow: rgba(16, 185, 129, 0.45);
    --grad: linear-gradient(135deg, #10b981 0%, #06b6d4 50%, #f59e0b 100%);
    --grad-glow: linear-gradient(90deg, #10b981, #06b6d4);
  }

  :global(body[data-world="alien"] .pulse-dot) {
    background: #10b981 !important;
    box-shadow: 0 0 10px #10b981 !important;
  }

  :global(body[data-world="alien"] .cyber-tag) {
    border-color: rgba(16, 185, 129, 0.4) !important;
    color: #34d399 !important;
  }

  /* WORLD 3: SOLAR GALAXY (SUN & EARTH) */
  :global(body[data-world="solar"]) {
    --border-glow: rgba(245, 158, 11, 0.45);
    --grad: linear-gradient(135deg, #f59e0b 0%, #fbbf24 45%, #38bdf8 100%);
    --grad-glow: linear-gradient(90deg, #f59e0b, #fbbf24);
  }

  :global(body[data-world="solar"] .pulse-dot) {
    background: #f59e0b !important;
    box-shadow: 0 0 10px #f59e0b !important;
  }

  :global(body[data-world="solar"] .cyber-tag) {
    border-color: rgba(245, 158, 11, 0.4) !important;
    color: #fcd34d !important;
  }

  html {
    scroll-behavior: auto;
  }

  body {
    overscroll-behavior: none;
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    overflow-x: hidden;
  }

  h1, h2, h3 {
    font-family: 'Space Grotesk', 'Inter', system-ui, sans-serif;
    letter-spacing: -0.025em;
    margin: 0;
  }

  /* 3D Perspective Stage Viewport */
  .stage-viewport {
    position: fixed;
    inset: 0;
    z-index: 1;
    perspective: 1200px;
    perspective-origin: 50% 50%;
    overflow: hidden;
    pointer-events: none;
  }

  .stage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    will-change: transform;
    pointer-events: none;
  }

  /* Ambient Cosmic Glows */
  .ambient-glows {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.28;
    animation: driftOrb 16s ease-in-out infinite alternate;
  }

  .orb-1 {
    width: 550px;
    height: 550px;
    top: 5%;
    left: 15%;
    background: radial-gradient(circle, #8b5cf6, transparent 70%);
  }

  .orb-2 {
    width: 600px;
    height: 600px;
    bottom: 5%;
    right: 10%;
    background: radial-gradient(circle, #ec4899, transparent 70%);
    animation-delay: -5s;
  }

  .orb-3 {
    width: 450px;
    height: 450px;
    top: 45%;
    right: 30%;
    background: radial-gradient(circle, #06b6d4, transparent 70%);
    animation-delay: -9s;
  }

  @keyframes driftOrb {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(40px, -50px) scale(1.15); }
  }

  .scroll-range {
    height: 500vh;
  }
</style>