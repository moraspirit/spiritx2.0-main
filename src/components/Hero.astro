      </div>
    </div>

    <!-- ======================================================== -->
    <!-- LAYER 1: HOME SECTION (Hero Intro, Key Stats, Quick CTAs)-->
    <!-- ======================================================== -->
    <div class="layer" data-name="home" data-index="1">
      <div class="home-container">
        <div class="home-copy">
          <p class="eyebrow">
            <span class="dot"></span>
            The Ultimate Collegiate Arena
          </p>
          <h1 class="main-title">
            Inter University
            <br />
            Hackathon
            <br />
            <span class="grad">Competition 2026</span>
          </h1>
          <p class="lead">
            The biggest inter-university hackathon in Sri Lanka. 48 hours, one
            stage, no limits. Bring your ideas, build with the best, and make
            history.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary btn-glow" href="#cta">Register Now</a>
            <a class="btn btn-ghost" href="#about">Explore Event</a>
          </div>
        </div>

        <div class="stats-card">
          <div class="stat">
            <span class="stat-num">48</span>
            <span class="stat-label">Hours Non-stop</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-num">200+</span>
            <span class="stat-label">Elite Hackers</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-num">20+</span>
            <span class="stat-label">Universities</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-num">5M+</span>
            <span class="stat-label">In Prize Pool</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ======================================================== -->
    <!-- LAYER 2: ABOUT SECTION (Interactive 3D Logo & Event Story)-->
    <!-- ======================================================== -->
    <div class="layer" data-name="about" data-index="2">
      <div class="about-grid">
        <div class="about-model-box">
          <div class="model-glow-ring"></div>
          <model-viewer
            class="about-model-viewer"
            src="/spiritxlogo4.glb"
            environment-image="neutral"
            shadow-intensity="1.2"
            camera-controls
            disable-zoom
            auto-rotate
            rotation-per-second="25deg"
            interaction-prompt="none"
          ></model-viewer>
