<script>
  import Lenis from 'lenis';

  const lenis = new Lenis({ duration: 1.1, smoothWheel: true });
  const raf = (time) => {
    lenis.raf(time);
    requestAnimationFrame(raf);
  };
  requestAnimationFrame(raf);

  const layers = Array.from(document.querySelectorAll('.layer'));
  const K = 1.5;
  const cl = (v) => Math.min(1, Math.max(0, v));
  const sm = (t) => t * t * (3 - 2 * t);

  const update = (e) => {
    const at = e && e.scroll != null ? e.scroll : 0;
    const raw = at / window.innerHeight;
    const vh = window.innerHeight;

    layers.forEach((el, i) => {
      let scale = 1;
      let opacity = 1;

      if (i === 0) {
        const t = sm(cl(raw));
        opacity = 1 - t;
      } else if (i === 1) {
        const tin = sm(cl(raw));
        const et = sm(cl(raw - 1));
        const y = (1 - tin) * vh;
        scale = 1 + et * (K - 1);
        opacity = tin * (1 - et);
        el.style.transform = `translate(-50%,-50%) translateY(${y.toFixed(1)}px) scale(${scale.toFixed(4)})`;
        el.style.opacity = opacity.toFixed(4);
        el.style.pointerEvents = opacity > 0.5 ? 'auto' : 'none';
        return;
      } else {
        const tin = sm(cl(raw - (i - 1)));
        const et = sm(cl(raw - i));
        scale = (1 / K + tin * (1 - 1 / K)) * (1 + et * (K - 1));
        opacity = tin * (1 - et);
      }

      el.style.transform = `translate(-50%,-50%) scale(${scale.toFixed(4)})`;
      el.style.opacity = opacity.toFixed(4);
      el.style.pointerEvents = opacity > 0.5 ? 'auto' : 'none';
    });
  };

  lenis.on('scroll', update);
  window.addEventListener('resize', () => update({ scroll: lenis.scroll }));
  update({ scroll: 0 });
</script>

