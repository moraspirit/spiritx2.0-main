---
---

<script>
  import '@google/model-viewer';
</script>

<div class="page">
  <section class="splash">
    <model-viewer
      class="splash-logo"
      src="/spiritxlogo4.glb"
      environment-image="neutral"
      shadow-intensity="1"
      camera-controls
      disable-zoom
      interaction-prompt="none"
    ></model-viewer>
    <model-viewer
      class="splash-dancer"
      src="/sambadanceboy.glb"
      environment-image="neutral"
      shadow-intensity="1"
      camera-controls
      disable-zoom
      interaction-prompt="none"
      animation-name="mixamo.com"
      autoplay
    ></model-viewer>
    <div class="splash-copy">
      <h1>
        Inter University Hackathon Competition
        <span class="grad">2026</span>
      </h1>
      <p>University of Moratuwa</p>
    </div>
    <a class="scroll-hint" href="#home">Scroll to explore &darr;</a>
  </section>

  <div class="splash-spacer" aria-hidden="true"></div>

  <div class="content">
  <nav class="nav">
    <a class="brand" href="/">
      <span class="brand-mark">SX</span>
      <span>MoraSpirit</span>
    </a>
    <div class="nav-links">
      <a href="#about">About</a>
      <a href="#tracks">Tracks</a>
      <a href="#faq">FAQ</a>
    </div>
    <a class="btn btn-primary btn-sm" href="#register">Register</a>
  </nav>

  <header id="home" class="hero">
    <div class="hero-glow"></div>
    <div class="hero-copy">
      <p class="eyebrow"><span class="dot"></span> Spirit X 2.0 &middot; 2026</p>
      <h1>
        Inter University
        <br />
        Hackathon
        <br />
        <span class="grad">Competition 2026</span>
      </h1>
      <p class="lead">
        The biggest inter-university hackathon in Sri Lanka. 48 hours, one
        stage, no limits. Bring your ideas, build with the best, and make
        history.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#register">Register Now</a>
        <a class="btn btn-ghost" href="#about">Learn More</a>
      </div>
      <div class="stats">
        <div class="stat">
          <span class="stat-num">48</span>
          <span class="stat-label">Hours</span>
        </div>
        <div class="stat">
          <span class="stat-num">200+</span>
          <span class="stat-label">Hackers</span>
        </div>
        <div class="stat">
          <span class="stat-num">20+</span>
          <span class="stat-label">Universities</span>
        </div>
        <div class="stat">
          <span class="stat-num">5M+</span>
          <span class="stat-label">In Prizes</span>
        </div>
      </div>
    </div>
  </header>

  <section class="marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>University of Moratuwa</span><i>&bull;</i>
      <span>University of Colombo</span><i>&bull;</i>
      <span>University of Peradeniya</span><i>&bull;</i>
      <span>University of Kelaniya</span><i>&bull;</i>
      <span>University of Ruhuna</span><i>&bull;</i>
      <span>NSBM</span><i>&bull;</i>
      <span>University of Moratuwa</span><i>&bull;</i>
      <span>University of Colombo</span><i>&bull;</i>
      <span>University of Peradeniya</span><i>&bull;</i>
      <span>University of Kelaniya</span><i>&bull;</i>
    </div>
  </section>

  <section id="about" class="section about">
    <div class="about-grid">
      <div class="about-model">
        <model-viewer
          src="/spiritxlogo4.glb"
          environment-image="neutral"
          shadow-intensity="1"
          camera-controls
          interaction-prompt="none"
          auto-rotate
        ></model-viewer>
      </div>
      <div class="about-copy">
        <p class="eyebrow"><span class="dot"></span> About the event</p>
        <h2>Built by students,<br />For students.</h2>
        <p>
          Spirit X is MoraSpirit's annual flagship hackathon hosted by the
          Media, Arts and Cultural Society of the University of Moratuwa. Open
          to every undergraduate across Sri Lanka, it's where raw talent meets
          real problems.
        </p>
        <ul class="about-list">
          <li>48 hours of non-stop building</li>
          <li>Mentors &amp; workshops from industry</li>
          <li>Live demos in front of top judges</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="tracks" class="section tracks">
    <p class="eyebrow center"><span class="dot"></span> Challenge tracks</p>
    <h2 class="center">Pick your battlefield</h2>
    <div class="tracks-grid">
      <div class="card">
        <span class="card-icon">&#9889;</span>
        <h3>AI &amp; Machine Learning</h3>
        <p>Intelligent systems that solve real South Asian problems.</p>
      </div>
      <div class="card">
        <span class="card-icon">&#128187;</span>
        <h3>Web &amp; Mobile</h3>
        <p>Products the world actually wants to use.</p>
      </div>
      <div class="card">
        <span class="card-icon">&#128248;</span>
        <h3>Creative Tech</h3>
        <p>3D, AR, VR and interactive media that amaze.</p>
      </div>
      <div class="card">
        <span class="card-icon">&#127793;</span>
        <h3>Sustainability</h3>
        <p>Green ideas for a smarter, cleaner island.</p>
      </div>
    </div>
  </section>

  <section id="register" class="section cta">
    <h2>Ready to dance with the best?</h2>
    <p>Registrations are open. Teams of 1&ndash;4. Zero experience required.</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#register">Register Now</a>
      <a class="btn btn-ghost" href="#">Download Brochure</a>
    </div>
  </section>

  <footer class="footer">
    <div class="footer-brand">
      <span class="brand-mark">SX</span>
      <div>
        <strong>MoraSpirit</strong>
        <p>&mdash; University Of Moratuwa</p>
      </div>
    </div>
    <p class="footer-note">
      Media, Arts &amp; Cultural Society &middot; University of Moratuwa
    </p>
    <p class="footer-copy">&copy; 2026 MoraSpirit. All rights reserved.</p>
  </footer>
  </div>
</div>

<style>
  :root {
    --bg: #0a0a12;
    --panel: #12121d;
    --border: rgba(255, 255, 255, 0.08);
    --text: #f4f4f8;
    --muted: #9a9aae;
    --grad: linear-gradient(90deg, #8b5cf6, #ec4899);
    --radius: 16px;
  }

  html {
    scroll-behavior: smooth;
  }

  .page {
    background: var(--bg);
    color: var(--text);
    font-family: "Inter", system-ui, -apple-system, sans-serif;
    overflow-x: hidden;
  }

  h1,
  h2,
  h3 {
    font-family: "Space Grotesk", "Inter", system-ui, sans-serif;
    letter-spacing: -0.02em;
  }

  /* Splash — models only */
  .splash {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: flex;
    background:
      radial-gradient(60% 60% at 20% 50%, rgba(236, 72, 153, 0.12), transparent 60%),
      radial-gradient(60% 60% at 80% 50%, rgba(139, 92, 246, 0.16), transparent 60%);
  }

  .splash model-viewer {
    width: 50%;
    height: 100%;
  }

  .splash-logo {
    animation: float 4.5s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-14px) scale(1.03);
    }
  }

  .splash-copy {
    position: absolute;
    left: 0;
    bottom: 5rem;
    width: 50%;
    padding: 0 clamp(1rem, 3vw, 3rem);
    text-align: center;
    pointer-events: none;
    z-index: 2;
  }

  .splash-copy h1 {
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 2.6rem);
    line-height: 1.1;
    font-weight: 800;
    text-wrap: balance;
  }

  .splash-copy p {
    margin: 0.6rem 0 0;
    color: var(--muted);
    font-size: clamp(0.9rem, 1.4vw, 1.2rem);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .splash-spacer {
    height: 100vh;
  }

  .content {
    position: relative;
    z-index: 1;
    background: var(--bg);
  }

  .scroll-hint {
    position: absolute;
    bottom: 1.2rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--muted);
    text-decoration: none;
    font-size: 0.8rem;
    z-index: 2;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  /* Nav */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem clamp(1rem, 5vw, 4rem);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--panel);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.05rem;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    background: var(--grad);
    font-size: 0.75rem;
    font-weight: 800;
    color: #fff;
  }

  .nav-links {
    display: flex;
    gap: 1.6rem;
  }

  .nav-links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--text);
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }

  .btn-primary {
    background: var(--grad);
    color: #fff;
    box-shadow: 0 8px 24px rgba(139, 92, 246, 0.35);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(236, 72, 153, 0.4);
  }

  .btn-ghost {
    color: var(--text);
    border: 1px solid var(--border);
  }

  .btn-ghost:hover {
    border-color: rgba(255, 255, 255, 0.35);
  }

  .btn-sm {
    padding: 0.55rem 1.2rem;
    font-size: 0.85rem;
  }

  /* Hero */
  .hero {
    position: relative;
    padding: clamp(4rem, 8vw, 7rem) clamp(1rem, 5vw, 4rem);
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(50% 60% at 80% 20%, rgba(139, 92, 246, 0.18), transparent 60%),
      radial-gradient(40% 50% at 10% 90%, rgba(236, 72, 153, 0.14), transparent 60%);
    pointer-events: none;
  }

  .hero-copy {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .eyebrow.center {
    justify-content: center;
    margin: 0 auto 0.75rem;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--grad);
    display: inline-block;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    line-height: 1.02;
    font-weight: 800;
  }

  .grad {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lead {
    margin: 1.4rem 0 0;
    max-width: 34rem;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2.2rem;
    margin-top: 2.6rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .stat-num {
    display: block;
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.8rem;
    font-weight: 700;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stat-label {
    color: var(--muted);
    font-size: 0.85rem;
  }

  /* Marquee */
  .marquee {
    overflow: hidden;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 1rem 0;
    background: var(--panel);
  }

  .marquee-track {
    display: flex;
    gap: 2rem;
    white-space: nowrap;
    width: max-content;
    animation: marquee 22s linear infinite;
  }

  .marquee-track span {
    color: var(--muted);
    font-weight: 500;
  }

  .marquee-track i {
    color: var(--grad);
    font-style: normal;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* Sections */
  .section {
    padding: clamp(4rem, 8vw, 7rem) clamp(1rem, 5vw, 4rem);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  .about-model {
    height: 420px;
  }

  .about-model model-viewer {
    width: 100%;
    height: 100%;
  }

  h2 {
    font-size: clamp(1.8rem, 4vw, 3rem);
    margin: 0 0 1rem;
    line-height: 1.08;
  }

  .about-copy p {
    color: var(--muted);
    line-height: 1.7;
  }

  .about-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 0.7rem;
  }

  .about-list li {
    padding-left: 1.4rem;
    position: relative;
    color: var(--text);
  }

  .about-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--grad);
  }

  .tracks h2 {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .tracks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.6rem;
    transition: transform 0.25s, border-color 0.25s;
  }

  .card:hover {
    transform: translateY(-5px);
    border-color: rgba(139, 92, 246, 0.5);
  }

  .card-icon {
    font-size: 1.6rem;
  }

  .card h3 {
    margin: 0.8rem 0 0.4rem;
    font-size: 1.15rem;
  }

  .card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  /* CTA */
  .cta {
    text-align: center;
    position: relative;
  }

  .cta::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(50% 80% at 50% 50%, rgba(139, 92, 246, 0.18), transparent 70%);
  }

  .cta h2,
  .cta p,
  .cta .hero-actions {
    position: relative;
  }

  .cta p {
    color: var(--muted);
    margin: 0 0 2rem;
  }

  .cta .hero-actions {
    justify-content: center;
    margin-top: 0;
  }

  /* Footer */
  .footer {
    border-top: 1px solid var(--border);
    padding: 2.5rem clamp(1rem, 5vw, 4rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--panel);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .footer-brand strong {
    display: block;
  }

  .footer-brand p {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .footer-note,
  .footer-copy {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 860px) {
    .nav-links {
      display: none;
    }

    .lead {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-copy {
      text-align: center;
    }

    .hero-actions,
    .stats {
      justify-content: center;
    }

    .about-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .about-list li {
      text-align: left;
    }

    .about-model {
      height: 300px;
    }
  }
</style>