<script>
  import '@google/model-viewer';
</script>

<script>
  import * as THREE from 'three';
  import Lenis from 'lenis';

  const initExperience = () => {
    const canvas = document.getElementById('web-canvas') as HTMLCanvasElement;
    const stageEl = document.getElementById('stage') as HTMLElement;
    const globalNav = document.getElementById('global-nav') as HTMLElement;
    const layers = Array.from(document.querySelectorAll('.layer')) as HTMLElement[];
    const navLinks = Array.from(document.querySelectorAll('.nav-links a')) as HTMLAnchorElement[];

    if (!canvas || !stageEl || layers.length === 0) return;

    // -----------------------------------------------------------
    // 1. Lenis Smooth Scroll Setup
    // -----------------------------------------------------------
    const lenis = new Lenis({
      duration: 1.25,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
    });

    let currentScroll = 0;
    let targetScroll = 0;
    let scrollVelocity = 0;

    lenis.on('scroll', (e) => {
      targetScroll = e.scroll;
      scrollVelocity = e.velocity || 0;
    });

    // -----------------------------------------------------------
    // 2. Mouse Tracking for Parallax & 3D Web Magnetism
    // -----------------------------------------------------------
    const mouse = { x: 0, y: 0, targetX: 0, targetY: 0 };
    const mouse3D = new THREE.Vector3(0, 0, 0);

    window.addEventListener('mousemove', (e) => {
      mouse.targetX = (e.clientX / window.innerWidth) * 2 - 1;
      mouse.targetY = -(e.clientY / window.innerHeight) * 2 + 1;
    });

    window.addEventListener('mouseleave', () => {
      mouse.targetX = 0;
      mouse.targetY = 0;
    });

    // -----------------------------------------------------------
    // 3. Three.js Animated Cyber Web & Deep Space Fly-through
    // -----------------------------------------------------------
    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);

    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x0a0a12, 0.00065);

    const camera = new THREE.PerspectiveCamera(65, window.innerWidth / window.innerHeight, 1, 5000);
    camera.position.z = 700;

    // Procedural glow sprite
    const createGlowTexture = () => {
      const c = document.createElement('canvas');
      c.width = 64;
      c.height = 64;
      const ctx = c.getContext('2d');
      if (ctx) {
        const grad = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
        grad.addColorStop(0, 'rgba(255, 255, 255, 1)');
        grad.addColorStop(0.2, 'rgba(168, 85, 247, 0.9)');
        grad.addColorStop(0.55, 'rgba(6, 182, 212, 0.4)');
        grad.addColorStop(1, 'rgba(10, 10, 18, 0)');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, 64, 64);
      }
      const tex = new THREE.CanvasTexture(c);
      tex.needsUpdate = true;
      return tex;
    };
    const glowTexture = createGlowTexture();

    // --- A. 3D Plexus / Neural Web System ---
    const NODE_COUNT = 135;
    const CONNECT_DIST = 160;
    const MAX_LINES = 750;

    interface PlexusNode {
      pos: THREE.Vector3;
      basePos: THREE.Vector3;
      vel: THREE.Vector3;
      pulseOffset: number;
      color: THREE.Color;
    }

    const nodes: PlexusNode[] = [];
    const colorPalette = [
      new THREE.Color(0x8b5cf6), // Violet
      new THREE.Color(0xec4899), // Pink
      new THREE.Color(0x06b6d4), // Cyan
      new THREE.Color(0x38bdf8), // Sky Blue
    ];

    const nodePositions = new Float32Array(NODE_COUNT * 3);
    const nodeColors = new Float32Array(NODE_COUNT * 3);

    for (let i = 0; i < NODE_COUNT; i++) {
      const pos = new THREE.Vector3(
        (Math.random() - 0.5) * 1700,
        (Math.random() - 0.5) * 1150,
        (Math.random() - 0.5) * 2800 - 700
      );
      const vel = new THREE.Vector3(
        (Math.random() - 0.5) * 0.45,
        (Math.random() - 0.5) * 0.45,
        (Math.random() - 0.5) * 0.35
      );
      const color = colorPalette[Math.floor(Math.random() * colorPalette.length)];

      nodes.push({
        pos,
        basePos: pos.clone(),
        vel,
        pulseOffset: Math.random() * Math.PI * 2,
        color,
      });

      nodePositions[i * 3] = pos.x;
      nodePositions[i * 3 + 1] = pos.y;
      nodePositions[i * 3 + 2] = pos.z;

      nodeColors[i * 3] = color.r;
      nodeColors[i * 3 + 1] = color.g;
      nodeColors[i * 3 + 2] = color.b;
    }

    const nodeGeometry = new THREE.BufferGeometry();
    nodeGeometry.setAttribute('position', new THREE.BufferAttribute(nodePositions, 3));
    nodeGeometry.setAttribute('color', new THREE.BufferAttribute(nodeColors, 3));

    const nodeMaterial = new THREE.PointsMaterial({
      size: 14,
      map: glowTexture,
      vertexColors: true,
      transparent: true,
      opacity: 0.95,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
    const nodePoints = new THREE.Points(nodeGeometry, nodeMaterial);
    scene.add(nodePoints);

    // Connecting Web Lines
    const linePositions = new Float32Array(MAX_LINES * 2 * 3);
    const lineColors = new Float32Array(MAX_LINES * 2 * 3);

    const lineGeometry = new THREE.BufferGeometry();
    lineGeometry.setAttribute('position', new THREE.BufferAttribute(linePositions, 3));
    lineGeometry.setAttribute('color', new THREE.BufferAttribute(lineColors, 3));

    const lineMaterial = new THREE.LineBasicMaterial({
      vertexColors: true,
      transparent: true,
      opacity: 0.85,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
    const lineSegments = new THREE.LineSegments(lineGeometry, lineMaterial);
    scene.add(lineSegments);

    // --- B. Cyber Tunnel Web Rings (Geometric Depth Markers) ---
    const tunnelGroup = new THREE.Group();
    const ringDepths = [400, -200, -800, -1400, -2000, -2600, -3200];
    const ringMeshes: THREE.LineLoop[] = [];

    ringDepths.forEach((zDepth, idx) => {
      const ringGeo = new THREE.BufferGeometry();
      const segments = 24;
      const radius = 460 + idx * 30;
      const pts: number[] = [];

      for (let s = 0; s < segments; s++) {
        const theta = (s / segments) * Math.PI * 2;
        pts.push(Math.cos(theta) * radius, Math.sin(theta) * radius, 0);
      }
      ringGeo.setAttribute('position', new THREE.Float32BufferAttribute(pts, 3));

      const ringColor = idx % 2 === 0 ? 0x8b5cf6 : 0x06b6d4;
      const ringMat = new THREE.LineBasicMaterial({
        color: ringColor,
        transparent: true,
        opacity: 0.24,
        blending: THREE.AdditiveBlending,
      });

      const ring = new THREE.LineLoop(ringGeo, ringMat);
      ring.position.z = zDepth;
      ringMeshes.push(ring);
      tunnelGroup.add(ring);
    });
    scene.add(tunnelGroup);

    // --- C. Warp Starfield / Cosmic Cyber Dust ---
    const STAR_COUNT = 1400;
    const starPositions = new Float32Array(STAR_COUNT * 3);
    const starColors = new Float32Array(STAR_COUNT * 3);
    const starVelocities: number[] = [];

    for (let i = 0; i < STAR_COUNT; i++) {
      starPositions[i * 3] = (Math.random() - 0.5) * 2400;
      starPositions[i * 3 + 1] = (Math.random() - 0.5) * 1700;
      starPositions[i * 3 + 2] = Math.random() * -3800 + 600;

      const starCol = colorPalette[Math.floor(Math.random() * colorPalette.length)];
      starColors[i * 3] = starCol.r;
      starColors[i * 3 + 1] = starCol.g;
      starColors[i * 3 + 2] = starCol.b;

      starVelocities.push(0.7 + Math.random() * 1.5);
    }

    const starGeometry = new THREE.BufferGeometry();
    starGeometry.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
    starGeometry.setAttribute('color', new THREE.BufferAttribute(starColors, 3));

    const starMaterial = new THREE.PointsMaterial({
      size: 10,
      map: glowTexture,
      vertexColors: true,
      transparent: true,
      opacity: 0.8,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
    const starPoints = new THREE.Points(starGeometry, starMaterial);
    scene.add(starPoints);

    // Window resize
    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    // -----------------------------------------------------------
    // 4. Three.js Frame Animation
    // -----------------------------------------------------------
    let frameTime = 0;

    const renderThree = () => {
      frameTime += 0.012;

      // Mouse Parallax on Camera
      mouse.x += (mouse.targetX - mouse.x) * 0.04;
      mouse.y += (mouse.targetY - mouse.y) * 0.04;

      camera.position.x = mouse.x * 110;
      camera.position.y = mouse.y * 70;
      camera.rotation.y = -mouse.x * 0.035;
      camera.rotation.x = mouse.y * 0.035;

      // Unproject mouse cursor plane into 3D world space at Z = 200
      mouse3D.set(mouse.x * 600, mouse.y * 400, 200);

      // Rotate & pulse cyber rings
      ringMeshes.forEach((ring, idx) => {
        const dir = idx % 2 === 0 ? 1 : -1;
        ring.rotation.z += 0.0025 * dir;
        const scalePulse = 1 + Math.sin(frameTime * 1.4 + idx) * 0.035;
        ring.scale.set(scalePulse, scalePulse, 1);
      });

      // Update Plexus Nodes
      const nodePosAttr = nodeGeometry.getAttribute('position') as THREE.BufferAttribute;
      const nodeArray = nodePosAttr.array as Float32Array;

      for (let i = 0; i < NODE_COUNT; i++) {
        const node = nodes[i];
        node.pos.x = node.basePos.x + Math.sin(frameTime + node.pulseOffset) * 45;
        node.pos.y = node.basePos.y + Math.cos(frameTime * 0.9 + node.pulseOffset) * 35;
        node.pos.z = node.basePos.z + Math.sin(frameTime * 0.7 + node.pulseOffset) * 40;

        // Interactive cursor magnetism: nodes near mouse are attracted
        const distToMouse = node.pos.distanceTo(mouse3D);
        if (distToMouse < 260) {
          const pullFactor = (1 - distToMouse / 260) * 0.14;
          node.pos.x += (mouse3D.x - node.pos.x) * pullFactor;
          node.pos.y += (mouse3D.y - node.pos.y) * pullFactor;
        }

        nodeArray[i * 3] = node.pos.x;
        nodeArray[i * 3 + 1] = node.pos.y;
        nodeArray[i * 3 + 2] = node.pos.z;
      }
      nodePosAttr.needsUpdate = true;

      // Update Connecting Web Lines
      const linePosAttr = lineGeometry.getAttribute('position') as THREE.BufferAttribute;
      const lineColAttr = lineGeometry.getAttribute('color') as THREE.BufferAttribute;
      const linePosArr = linePosAttr.array as Float32Array;
      const lineColArr = lineColAttr.array as Float32Array;

      let lineCount = 0;

      // Node-to-node dynamic lines
      for (let i = 0; i < NODE_COUNT && lineCount < MAX_LINES - 45; i++) {
        for (let j = i + 1; j < NODE_COUNT && lineCount < MAX_LINES - 45; j++) {
          const p1 = nodes[i].pos;
          const p2 = nodes[j].pos;
          const dx = p1.x - p2.x;
          const dy = p1.y - p2.y;
          const dz = p1.z - p2.z;
          const distSq = dx * dx + dy * dy + dz * dz;

          if (distSq < CONNECT_DIST * CONNECT_DIST) {
            const dist = Math.sqrt(distSq);
            const alpha = Math.pow(1 - dist / CONNECT_DIST, 1.4) * 0.9;

            const idx = lineCount * 6;
            linePosArr[idx] = p1.x;
            linePosArr[idx + 1] = p1.y;
            linePosArr[idx + 2] = p1.z;

            linePosArr[idx + 3] = p2.x;
            linePosArr[idx + 4] = p2.y;
            linePosArr[idx + 5] = p2.z;

            const c1 = nodes[i].color;
            const c2 = nodes[j].color;

            lineColArr[idx] = c1.r * alpha;
            lineColArr[idx + 1] = c1.g * alpha;
            lineColArr[idx + 2] = c1.b * alpha;

            lineColArr[idx + 3] = c2.r * alpha;
            lineColArr[idx + 4] = c2.g * alpha;
            lineColArr[idx + 5] = c2.b * alpha;

            lineCount++;
          }
        }
      }

      // Interactive mouse spiderweb lines
      if (Math.abs(mouse.targetX) > 0.01 || Math.abs(mouse.targetY) > 0.01) {
        for (let i = 0; i < NODE_COUNT && lineCount < MAX_LINES; i++) {
          const p = nodes[i].pos;
          const distToCursor = p.distanceTo(mouse3D);
          if (distToCursor < 250) {
            const alpha = Math.pow(1 - distToCursor / 250, 1.2) * 0.95;
            const idx = lineCount * 6;

            linePosArr[idx] = p.x;
            linePosArr[idx + 1] = p.y;
            linePosArr[idx + 2] = p.z;

            linePosArr[idx + 3] = mouse3D.x;
            linePosArr[idx + 4] = mouse3D.y;
            linePosArr[idx + 5] = mouse3D.z;

            lineColArr[idx] = 0.92 * alpha;
            lineColArr[idx + 1] = 0.28 * alpha;
            lineColArr[idx + 2] = 0.95 * alpha;

            lineColArr[idx + 3] = 0.02 * alpha;
            lineColArr[idx + 4] = 0.71 * alpha;
            lineColArr[idx + 5] = 0.83 * alpha;

            lineCount++;
          }
        }
      }

      lineGeometry.setDrawRange(0, lineCount * 2);
      linePosAttr.needsUpdate = true;
      lineColAttr.needsUpdate = true;

      // Update Warp Stars (accelerates on scroll velocity)
      const starPosAttr = starGeometry.getAttribute('position') as THREE.BufferAttribute;
      const starPosArr = starPosAttr.array as Float32Array;
      const warpSpeed = 1.2 + Math.abs(scrollVelocity) * 0.09;

      for (let i = 0; i < STAR_COUNT; i++) {
        starPosArr[i * 3 + 2] += starVelocities[i] * warpSpeed;

        if (starPosArr[i * 3 + 2] > 700) {
          starPosArr[i * 3 + 2] = -3800;
          starPosArr[i * 3] = (Math.random() - 0.5) * 2400;
          starPosArr[i * 3 + 1] = (Math.random() - 0.5) * 1700;
        }
      }
      starPosAttr.needsUpdate = true;

      renderer.render(scene, camera);
    };

    // -----------------------------------------------------------
    // 5. Realistic 3D Spatial "Deep to Real" Layer Engine
    // -----------------------------------------------------------
    let smoothProgress = 0;
    let targetProgress = 0;
    let lastActiveIndex = -1;

    const updateSpatialLayers = () => {
      const scrollMax = document.documentElement.scrollHeight - window.innerHeight;
      targetProgress = scrollMax > 0 ? (currentScroll / scrollMax) * (layers.length - 1) : 0;

      // Smooth lerp for continuous physical momentum
      smoothProgress += (targetProgress - smoothProgress) * 0.085;

      // Holographic 3D Stage tilt from mouse
      const tiltX = -mouse.y * 3.5;
      const tiltY = mouse.x * 3.5;
      stageEl.style.transform = `rotateX(${tiltX.toFixed(2)}deg) rotateY(${tiltY.toFixed(2)}deg)`;

      // Persistent navigation bar toggle
      if (globalNav) {
        if (smoothProgress > 0.35) {
          globalNav.classList.add('nav-visible');
        } else {
          globalNav.classList.remove('nav-visible');
        }
      }

      // Active section in nav
      const activeIndex = Math.round(smoothProgress);
      if (activeIndex !== lastActiveIndex) {
        lastActiveIndex = activeIndex;
        navLinks.forEach((link) => {
          const target = link.getAttribute('data-target');
          if (target && parseInt(target, 10) === activeIndex) {
            link.classList.add('active');
          } else {
            link.classList.remove('active');
          }
        });
      }

      // 3D Depth Transforms for Each Layer ("from deep to real")
      layers.forEach((layer, i) => {
        const delta = smoothProgress - i;

        // Culling
        if (Math.abs(delta) > 1.35) {
          layer.style.opacity = '0';
          layer.style.visibility = 'hidden';
          layer.style.pointerEvents = 'none';
          return;
        }

        layer.style.visibility = 'visible';

        if (delta < 0) {
          // COMING FROM DEEP SPACE (negative Z to 0)
          const u = -delta; // 1.35 -> 0
          const pIn = Math.pow(u, 1.28);

          const z = -pIn * 1750;
          const y = pIn * 45;
          const scale = Math.max(0.35, 1 - pIn * 0.22);
          const blur = Math.min(14, pIn * 11);
          const opacity = Math.max(0, 1 - Math.pow(u / 1.05, 1.45));

          layer.style.transform = `translate3d(0, ${y.toFixed(1)}px, ${z.toFixed(1)}px) scale(${scale.toFixed(3)})`;
          layer.style.filter = blur > 0.2 ? `blur(${blur.toFixed(1)}px)` : 'none';
          layer.style.opacity = opacity.toFixed(3);
          layer.style.pointerEvents = Math.abs(delta) < 0.28 ? 'auto' : 'none';
        } else {
          // FLYING PAST CAMERA (0 to positive Z)
          const v = delta; // 0 -> 1.35
          const pOut = Math.pow(v, 1.25);

          const z = pOut * 950;
          const y = -pOut * 55;
          const blur = Math.min(16, pOut * 13);
          const opacity = Math.max(0, 1 - Math.pow(v / 0.82, 1.6));

          layer.style.transform = `translate3d(0, ${y.toFixed(1)}px, ${z.toFixed(1)}px)`;
          layer.style.filter = blur > 0.2 ? `blur(${blur.toFixed(1)}px)` : 'none';
          layer.style.opacity = opacity.toFixed(3);
          layer.style.pointerEvents = Math.abs(delta) < 0.28 ? 'auto' : 'none';
        }
      });
    };

    // -----------------------------------------------------------
    // 6. Anchor Nav Link Navigation
    // -----------------------------------------------------------
    const scrollTargets: Record<string, number> = {
      '#home': 1,
      '#about': 2,
      '#tracks': 3,
      '#cta': 4,
    };

    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        const href = anchor.getAttribute('href');
        if (href && scrollTargets[href] !== undefined) {
          e.preventDefault();
          const targetIndex = scrollTargets[href];
          const scrollMax = document.documentElement.scrollHeight - window.innerHeight;
          const dest = (targetIndex / (layers.length - 1)) * scrollMax;

          lenis.scrollTo(dest, {
            duration: 1.4,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          });
        }
      });
    });

    // -----------------------------------------------------------
    // 7. Master Render Animation Loop
    // -----------------------------------------------------------
    const masterLoop = (time: number) => {
      lenis.raf(time);
      currentScroll = lenis.scroll;

      renderThree();
      updateSpatialLayers();

      requestAnimationFrame(masterLoop);
    };

    requestAnimationFrame(masterLoop);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initExperience);
  } else {
    initExperience();
  }
</script>

<!-- Background 3D Cyber WebGL Canvas -->
<canvas id="web-canvas" class="web-canvas" aria-hidden="true"></canvas>

