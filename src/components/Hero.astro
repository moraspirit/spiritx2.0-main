<style>
  :root {
    --bg: #0a0a12;
    --panel: #12121d;
    --border: rgba(255, 255, 255, 0.08);
    --text: #f4f4f8;
    --muted: #9a9aae;
    --grad: linear-gradient(90deg, #8b5cf6, #ec4899);
    --radius: 16px;
  }

  html {
    scroll-behavior: auto;
  }

  body {
    overscroll-behavior: none;
  }

  .page,
  body {
    font-family: "Inter", system-ui, -apple-system, sans-serif;
    background: var(--bg);
    color: var(--text);
    overflow-x: hidden;
  }

  h1,
  h2,
  h3 {
    font-family: "Space Grotesk", "Inter", system-ui, sans-serif;
    letter-spacing: -0.02em;
    margin: 0;
  }

  /* Starfield */
  .stars {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(1.5px 1.5px at 12% 20%, rgba(255, 255, 255, 0.9), transparent 60%),
      radial-gradient(1px 1px at 25% 65%, rgba(255, 255, 255, 0.6), transparent 60%),
      radial-gradient(2px 2px at 40% 12%, rgba(255, 255, 255, 0.7), transparent 60%),
      radial-gradient(1px 1px at 55% 40%, rgba(255, 255, 255, 0.5), transparent 60%),
      radial-gradient(1.5px 1.5px at 70% 75%, rgba(255, 255, 255, 0.8), transparent 60%),
      radial-gradient(1px 1px at 82% 25%, rgba(255, 255, 255, 0.6), transparent 60%),
      radial-gradient(2px 2px at 92% 60%, rgba(255, 255, 255, 0.7), transparent 60%),
      radial-gradient(1px 1px at 8% 85%, rgba(255, 255, 255, 0.5), transparent 60%),
      radial-gradient(1.5px 1.5px at 33% 35%, rgba(255, 255, 255, 0.6), transparent 60%),
      radial-gradient(1px 1px at 60% 90%, rgba(255, 255, 255, 0.7), transparent 60%);
    animation: twinkle 7s ease-in-out infinite;
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }

  /* Stage + scrolling room */
  .stage {
    position: fixed;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  .scroll-range {
    height: 400vh;
  }

  /* Layers */
  .layer {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100%;
    height: 100%;
    padding: clamp(1rem, 4vw, 4rem);
    transform: translate(-50%, -50%) scale(1);
    will-change: transform, opacity;
  }

  /* ---- Buttons ---- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .btn-primary {
    background: var(--grad);
    color: #fff;
    box-shadow: 0 8px 24px rgba(139, 92, 246, 0.35);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(236, 72, 153, 0.4);
  }

  .btn-ghost {
    color: var(--text);
    border: 1px solid var(--border);
  }

  .btn-ghost:hover {
    border-color: rgba(255, 255, 255, 0.35);
  }

  .btn-sm {
    padding: 0.55rem 1.2rem;
    font-size: 0.85rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }

  .center-actions {
    justify-content: center;
    margin-top: 2rem;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .eyebrow.center {
    justify-content: center;
    margin: 0 auto 0.75rem;
    display: flex;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--grad);
    display: inline-block;
  }

  .grad {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* ---- Layer 0: splash ---- */
  .layer[data-name="splash"] {
    display: flex;
  }

  .splash-logo,
  .splash-dancer {
    flex: 1;
    height: 100%;
    width: 50%;
  }

  .splash-logo {
    animation: float 4.5s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-14px) scale(1.03);
    }
  }

  .splash-copy {
    position: absolute;
    left: 0;
    bottom: 5rem;
    width: 50%;
    padding: 0 clamp(1rem, 3vw, 3rem);
    text-align: center;
    pointer-events: none;
  }

  .splash-copy h1 {
    font-size: clamp(1.4rem, 3vw, 2.6rem);
    line-height: 1.1;
    font-weight: 800;
    text-wrap: balance;
  }

  .splash-copy p {
    margin: 0.6rem 0 0;
    color: var(--muted);
    font-size: clamp(0.9rem, 1.4vw, 1.2rem);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .scroll-hint {
    position: absolute;
    bottom: 1.2rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--muted);
    text-decoration: none;
    font-size: 0.8rem;
    z-index: 2;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  /* ---- Layer 1: home ---- */
  .layer[data-name="home"] {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .nav {
    position: absolute;
    top: clamp(1rem, 3vh, 2rem);
    left: clamp(1rem, 4vw, 4rem);
    right: clamp(1rem, 4vw, 4rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.4rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(18, 18, 29, 0.65);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.05rem;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    background: var(--grad);
    font-size: 0.75rem;
    font-weight: 800;
    color: #fff;
  }

  .nav-links {
    display: flex;
    gap: 1.6rem;
  }

  .nav-links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .nav-links a:hover {
    color: var(--text);
  }

  .home-copy {
    max-width: 680px;
  }

  .home-copy h1 {
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1.02;
    font-weight: 800;
  }

  .lead {
    margin: 1.4rem 0 0;
    max-width: 34rem;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .stats {
    position: absolute;
    bottom: clamp(2rem, 6vh, 4rem);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: clamp(1.5rem, 5vw, 4rem);
    padding: 1.4rem 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgba(18, 18, 29, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .stat-num {
    display: block;
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.6rem;
    font-weight: 700;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stat-label {
    color: var(--muted);
    font-size: 0.8rem;
  }

  /* ---- Layer 2: about ---- */
  .layer[data-name="about"] {
    display: grid;
    place-items: center;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
    max-width: 1000px;
  }

  .about-model {
    height: clamp(280px, 50vh, 480px);
  }

  .about-model model-viewer {
    width: 100%;
    height: 100%;
  }

  h2 {
    font-size: clamp(1.6rem, 3.4vw, 2.6rem);
    margin-bottom: 1rem;
    line-height: 1.08;
  }

  .about-copy p {
    color: var(--muted);
    line-height: 1.7;
  }

  .about-list {
    list-style: none;
    padding: 0;
    margin: 1.4rem 0 0;
    display: grid;
    gap: 0.7rem;
  }

  .about-list li {
    padding-left: 1.4rem;
    position: relative;
    color: var(--text);
  }

  .about-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--grad);
  }

  /* ---- Layer 3: tracks ---- */
  .layer[data-name="tracks"] {
    display: grid;
    place-content: center;
    text-align: center;
  }

  .layer[data-name="tracks"] h2 {
    margin-bottom: 2rem;
  }

  .tracks-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(220px, 1fr));
    gap: 1.2rem;
    max-width: 720px;
    margin: 0 auto;
  }

  .card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    text-align: left;
    transition: transform 0.25s, border-color 0.25s;
  }

  .card:hover {
    transform: translateY(-5px);
    border-color: rgba(139, 92, 246, 0.5);
  }

  .card-icon {
    font-size: 1.5rem;
  }

  .card h3 {
    margin: 0.8rem 0 0.4rem;
    font-size: 1.1rem;
  }

  .card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  /* ---- Layer 4: cta + footer ---- */
  .layer[data-name="cta"] {
    display: grid;
    place-content: center;
    text-align: center;
  }

  .cta-box {
    position: relative;
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid var(--border);
    border-radius: 24px;
    background: rgba(18, 18, 29, 0.7);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    max-width: 640px;
    margin: 0 auto;
  }

  .cta-box p {
    color: var(--muted);
    margin: 0.5rem 0 0;
  }

  .footer {
    position: absolute;
    bottom: clamp(1rem, 3vh, 2rem);
    left: clamp(1rem, 4vw, 4rem);
    right: clamp(1rem, 4vw, 4rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .footer-brand strong {
    display: block;
  }

  .footer-brand p {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .footer-copy {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0;
  }

  /* ---- Responsive ---- */
  @media (max-width: 860px) {
    .nav-links {
      display: none;
    }

    .layer {
      padding: 1.5rem;
    }

    .splash-copy {
      bottom: 4rem;
    }

    .home-copy {
      text-align: center;
      margin: 0 auto;
    }

    .home-copy .lead {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-actions,
    .center-actions {
      justify-content: center;
    }

    .stats {
      gap: 1.2rem;
      padding: 1rem 1.4rem;
    }

    .about-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .about-list li {
      text-align: left;
      max-width: 300px;
      margin-left: auto;
      margin-right: auto;
    }

    .about-model {
      height: 260px;
    }

    .tracks-grid {
      grid-template-columns: 1fr;
      max-width: 400px;
    }
  }
</style>