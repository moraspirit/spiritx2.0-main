     ----------------------------------------------------------- */
  .web-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
  }

  .ambient-glows {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.28;
    animation: driftOrb 16s ease-in-out infinite alternate;
  }

  .orb-1 {
    width: 550px;
    height: 550px;
    top: 5%;
    left: 15%;
    background: radial-gradient(circle, #8b5cf6, transparent 70%);
  }

  .orb-2 {
    width: 600px;
    height: 600px;
    bottom: 5%;
    right: 10%;
    background: radial-gradient(circle, #ec4899, transparent 70%);
    animation-delay: -5s;
  }

  .orb-3 {
    width: 450px;
    height: 450px;
    top: 45%;
    right: 30%;
    background: radial-gradient(circle, #06b6d4, transparent 70%);
    animation-delay: -9s;
  }

  @keyframes driftOrb {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(40px, -50px) scale(1.15); }
  }

  /* -----------------------------------------------------------
     3. Persistent Global Nav
     ----------------------------------------------------------- */
  .global-nav {
    position: fixed;
    top: 1.5rem;
    left: clamp(1rem, 4vw, 4rem);
