<style>
  /* -----------------------------------------------------------
     1. CSS Variables & Deep Space Theme
     ----------------------------------------------------------- */
  :root {
    --bg: #0a0a12;
    --panel: #11111e;
    --panel-glow: rgba(139, 92, 246, 0.12);
    --border: rgba(255, 255, 255, 0.08);
    --border-glow: rgba(139, 92, 246, 0.35);
    --text: #f4f4f8;
    --muted: #9a9aae;
    --grad: linear-gradient(135deg, #8b5cf6 0%, #ec4899 50%, #06b6d4 100%);
    --grad-glow: linear-gradient(90deg, #8b5cf6, #ec4899);
    --radius-sm: 10px;
    --radius-md: 18px;
    --radius-lg: 28px;
  }

  html {
    scroll-behavior: auto;
  }

  body {
    overscroll-behavior: none;
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    overflow-x: hidden;
  }

  h1, h2, h3 {
    font-family: 'Space Grotesk', 'Inter', system-ui, sans-serif;
    letter-spacing: -0.025em;
    margin: 0;
  }

  /* -----------------------------------------------------------
     2. 3D WebGL Canvas & Hyperspace Warp Shockwave
     ----------------------------------------------------------- */
  .web-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
  }

  .warp-flash {
    position: fixed;
    inset: 0;
    z-index: 45;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      circle at center,
      rgba(255, 255, 255, 0.95) 0%,
      rgba(139, 92, 246, 0.75) 45%,
      rgba(6, 182, 212, 0.3) 70%,
      transparent 90%
    );
    mix-blend-mode: screen;
    transition: opacity 0.12s ease-out;
  }

  /* -----------------------------------------------------------
     3. Astronaut / Shuttle Cockpit HUD (Active in Deep Space)
     ----------------------------------------------------------- */
  .space-hud {
    position: fixed;
    inset: 0;
    z-index: 40;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
    font-family: 'Space Grotesk', ui-monospace, monospace;
  }

  .hud-top {
    position: absolute;
    top: 5.5rem;
    left: clamp(1rem, 4vw, 4rem);
    right: clamp(1rem, 4vw, 4rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem 1rem;
    border-top: 1px solid rgba(6, 182, 212, 0.35);
    border-bottom: 1px solid rgba(139, 92, 246, 0.25);
    background: rgba(10, 10, 18, 0.4);
    backdrop-filter: blur(4px);
    font-size: 0.72rem;
    color: #38bdf8;
    letter-spacing: 0.12em;
  }

  .hud-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
  }

  .hud-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #06b6d4;
    box-shadow: 0 0 8px #06b6d4;
    animation: pulseDot 1.4s infinite;
  }

  .hud-center-text {
    font-weight: 700;
    color: #e0e7ff;
    letter-spacing: 0.15em;
  }

  .hud-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--muted);
  }

  .hud-sep {
    color: #38bdf8;
    opacity: 0.5;
  }

  .hud-left,
  .hud-right {
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    width: 140px;
    display: flex;
    flex-direction: column;
    color: #38bdf8;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .hud-left {
    left: clamp(1rem, 3vw, 2.5rem);
  }

  .hud-right {
    right: clamp(1rem, 3vw, 2.5rem);
    text-align: right;
  }

  .hud-bracket-top {
    height: 12px;
    border-top: 1px solid rgba(6, 182, 212, 0.45);
    border-left: 1px solid rgba(6, 182, 212, 0.45);
  }

  .hud-right .hud-bracket-top {
    border-left: none;
    border-right: 1px solid rgba(6, 182, 212, 0.45);
  }

  .hud-bracket-bot {
    height: 12px;
    border-bottom: 1px solid rgba(6, 182, 212, 0.45);
    border-left: 1px solid rgba(6, 182, 212, 0.45);
  }

  .hud-right .hud-bracket-bot {
    border-left: none;
    border-right: 1px solid rgba(6, 182, 212, 0.45);
  }

  .hud-ladder,
  .hud-g-meter {
    padding: 0.6rem 0.4rem;
  }

  .ladder-label,
  .meter-label {
    font-size: 0.65rem;
    color: var(--muted);
    font-weight: 600;
  }

  .ladder-val,
  .meter-val {
    font-size: 1.1rem;
    font-weight: 800;
    color: #f4f4f8;
    margin: 0.25rem 0 0.6rem;
  }

  .ladder-ticks {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border-left: 2px dashed rgba(6, 182, 212, 0.3);
    padding-left: 0.5rem;
  }

  .tick {
    color: var(--muted);
    font-size: 0.62rem;
  }

  .tick.active {
    color: #22d3ee;
    font-weight: 700;
  }

  .meter-bar-track {
    width: 100%;
    height: 6px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 0.4rem;
  }

  .meter-bar-fill {
    width: 65%;
    height: 100%;
    background: linear-gradient(90deg, #06b6d4, #ec4899);
    border-radius: 999px;
  }

  .meter-status {
    font-size: 0.62rem;
    color: #4ade80;
  }

  /* Targeting Reticle */
  .hud-reticle {
    position: fixed;
    top: 0;
    left: 0;
    width: 48px;
    height: 48px;
    margin-left: -24px;
    margin-top: -24px;
    pointer-events: none;
    transition: transform 0.06s ease-out;
    opacity: 0.45;
  }

  .reticle-ring {
    width: 100%;
    height: 100%;
    border: 1px dashed rgba(6, 182, 212, 0.5);
    border-radius: 50%;
    animation: spinReticle 12s linear infinite;
  }

  .reticle-cross {
    position: absolute;
    inset: 50%;
    width: 6px;
    height: 6px;
    transform: translate(-50%, -50%);
    background: #06b6d4;
    border-radius: 50%;
    box-shadow: 0 0 8px #06b6d4;
  }

  @keyframes spinReticle {
    to { transform: rotate(360deg); }
  }

  /* -----------------------------------------------------------
     4. Ambient Glows
     ----------------------------------------------------------- */
  .ambient-glows {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.28;
    animation: driftOrb 16s ease-in-out infinite alternate;
  }

  .orb-1 {
    width: 550px;
    height: 550px;
    top: 5%;
    left: 15%;
    background: radial-gradient(circle, #8b5cf6, transparent 70%);
  }

  .orb-2 {
    width: 600px;
    height: 600px;
    bottom: 5%;
    right: 10%;
    background: radial-gradient(circle, #ec4899, transparent 70%);
    animation-delay: -5s;
  }

  .orb-3 {
    width: 450px;
    height: 450px;
    top: 45%;
    right: 30%;
    background: radial-gradient(circle, #06b6d4, transparent 70%);
    animation-delay: -9s;
  }

  @keyframes driftOrb {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(40px, -50px) scale(1.15); }
  }

  /* -----------------------------------------------------------
     5. Persistent Global Nav
     ----------------------------------------------------------- */
  .global-nav {
    position: fixed;
    top: 1.5rem;
    left: clamp(1rem, 4vw, 4rem);
    right: clamp(1rem, 4vw, 4rem);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    background: rgba(14, 14, 24, 0.72);
    border: 1px solid var(--border);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-15px);
    transition: opacity 0.4s ease, transform 0.4s ease, border-color 0.3s ease;
  }

  .global-nav.nav-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .global-nav:hover {
    border-color: var(--border-glow);
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--text);
    font-weight: 700;
    font-size: 1.05rem;
  }

  .brand-badge {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    background: var(--grad-glow);
    font-size: 0.78rem;
    font-weight: 800;
    color: #fff;
    box-shadow: 0 0 15px rgba(139, 92, 246, 0.5);
  }

  .nav-links {
    display: flex;
    gap: 1.8rem;
  }

  .nav-links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    transition: color 0.2s ease;
    position: relative;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: #fff;
  }

  .nav-links a.active::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 20%;
    right: 20%;
    height: 2px;
    background: var(--grad-glow);
    border-radius: 999px;
  }

  /* -----------------------------------------------------------
     6. 3D Perspective Stage Viewport
     ----------------------------------------------------------- */
  .stage-viewport {
    position: fixed;
    inset: 0;
    z-index: 1;
    perspective: 1200px;
    perspective-origin: 50% 50%;
    overflow: hidden;
    pointer-events: none;
  }

  .stage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    will-change: transform;
    pointer-events: none;
  }

  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 4rem);
    transform-style: preserve-3d;
    will-change: transform, opacity, filter;
    backface-visibility: hidden;
    pointer-events: none;
  }

  /* -----------------------------------------------------------
     7. Layer 0: Splash Screen
     ----------------------------------------------------------- */
  .splash-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
  }

  .splash-models-container {
    position: absolute;
    inset: 0;
    display: flex;
    width: 100%;
    height: 100%;
    pointer-events: auto;
  }

  .model-pod {
    flex: 1;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .splash-model {
    width: 100%;
    height: 90%;
    outline: none;
  }

  .splash-logo {
    animation: floatLogo 5s ease-in-out infinite;
  }

  @keyframes floatLogo {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-16px) rotate(1.5deg); }
  }

  .splash-content {
    position: relative;
    z-index: 2;
    max-width: 680px;
    margin-top: clamp(2rem, 8vh, 6rem);
    text-align: center;
    pointer-events: auto;
  }

  .cyber-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    background: rgba(18, 18, 29, 0.7);
    border: 1px solid var(--border-glow);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #c084fc;
    box-shadow: 0 0 15px rgba(139, 92, 246, 0.2);
    margin-bottom: 1.2rem;
  }

  .cyber-tag.center {
    margin: 0 auto 1.4rem;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22d3ee;
    box-shadow: 0 0 8px #22d3ee;
    animation: pulseDot 1.8s infinite;
  }

  @keyframes pulseDot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.5; }
  }

  .splash-title {
    font-size: clamp(2rem, 4.8vw, 3.8rem);
    line-height: 1.05;
    font-weight: 800;
    text-wrap: balance;
  }

  .text-glow {
    background: linear-gradient(90deg, #fff, #c084fc);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    display: inline-block;
  }

  .splash-sub {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding: 0.65rem 1.4rem;
    border-radius: 999px;
    background: rgba(14, 14, 24, 0.65);
    border: 1px solid var(--border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
  }

  .splash-sub .sub-brand {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 1.15rem;
    background: var(--grad-glow);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .splash-sub .sub-divider {
    color: var(--muted);
    opacity: 0.5;
  }

  .splash-sub .sub-uni {
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .scroll-hint {
    position: relative;
    z-index: 2;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    pointer-events: auto;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .scroll-hint:hover {
    color: #fff;
    transform: translateY(3px);
  }

  .hint-chevron {
    font-size: 1.2rem;
    color: #c084fc;
    animation: bounceChevron 1.8s infinite;
  }

  @keyframes bounceChevron {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  /* -----------------------------------------------------------
     8. Layer 1: Home Section
     ----------------------------------------------------------- */
  .home-container {
    max-width: 1000px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3.5rem;
  }

  .home-copy {
    max-width: 660px;
    transform: translateZ(40px);
  }

  .main-title {
    font-size: clamp(2.4rem, 5.5vw, 4.4rem);
    line-height: 1.02;
    font-weight: 800;
    margin-top: 0.5rem;
  }

  .lead {
    margin: 1.4rem 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.65;
    max-width: 35rem;
  }

  .stats-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 1.4rem 2.2rem;
    border-radius: var(--radius-md);
    background: rgba(18, 18, 29, 0.65);
    border: 1px solid var(--border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
    transform: translateZ(30px);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .stat-num {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    font-weight: 800;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stat-label {
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .stat-divider {
    width: 1px;
    height: 2.2rem;
    background: var(--border);
  }

  /* -----------------------------------------------------------
     9. Layer 2: About Section (Space Station Docking)
     ----------------------------------------------------------- */
  .about-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    max-width: 1050px;
    width: 100%;
  }

  .about-model-box {
    position: relative;
    height: clamp(300px, 50vh, 480px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transform: translateZ(50px);
  }

  .model-glow-ring {
    position: absolute;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.25), rgba(139, 92, 246, 0.15), transparent 70%);
    filter: blur(40px);
    pointer-events: none;
  }

  .about-model-viewer {
    width: 100%;
    height: 100%;
    outline: none;
    pointer-events: auto;
  }

  .model-hint {
    margin-top: -1.5rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #38bdf8;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(10, 10, 18, 0.6);
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(6, 182, 212, 0.3);
  }

  .about-copy {
    transform: translateZ(35px);
  }

  .about-copy h2 {
    font-size: clamp(1.8rem, 3.8vw, 2.8rem);
    line-height: 1.1;
    margin-bottom: 1.2rem;
  }

  .about-desc {
    color: var(--muted);
    line-height: 1.7;
    font-size: 1.02rem;
    margin: 0 0 1.5rem;
  }

  .about-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .about-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .list-bullet {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #f59e0b;
    box-shadow: 0 0 8px #f59e0b;
    margin-top: 0.45rem;
    flex-shrink: 0;
  }

  .about-list strong {
    display: block;
    color: var(--text);
    font-size: 1rem;
  }

  .about-list span {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  /* -----------------------------------------------------------
     10. Layer 3: Tracks Section (Zero-G Modular Mission Pods)
     ----------------------------------------------------------- */
  .tracks-wrapper {
    max-width: 900px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .section-header {
    text-align: center;
    margin-bottom: 2.2rem;
    transform: translateZ(40px);
  }

  .section-header h2 {
    font-size: clamp(1.8rem, 3.8vw, 2.8rem);
    margin-top: 0.4rem;
  }

  .section-lead {
    color: var(--muted);
    font-size: 0.98rem;
    margin-top: 0.6rem;
  }

  .tracks-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.4rem;
    width: 100%;
    transform-style: preserve-3d;
  }

  .track-card {
    position: relative;
    padding: 1.8rem;
    border-radius: var(--radius-md);
    background: rgba(18, 18, 29, 0.72);
    border: 1px solid var(--border);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    will-change: transform;
  }

  .track-card:hover {
    transform: translateY(-8px) scale(1.02) !important;
    border-color: rgba(6, 182, 212, 0.6);
    box-shadow: 0 16px 35px rgba(6, 182, 212, 0.2);
  }

  .card-glow {
    position: absolute;
    top: 0;
    right: 0;
    width: 130px;
    height: 130px;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.18), transparent 70%);
    pointer-events: none;
  }

  .card-icon-wrap {
    font-size: 1.8rem;
    margin-bottom: 0.9rem;
  }

  .track-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .track-card p {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0 0 1.2rem;
    flex-grow: 1;
  }

  .card-badge {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #38bdf8;
    background: rgba(6, 182, 212, 0.1);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgba(6, 182, 212, 0.25);
  }

  /* -----------------------------------------------------------
     11. Layer 4: CTA & Footer (Event Horizon Portal)
     ----------------------------------------------------------- */
  .cta-wrapper {
    max-width: 800px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    padding: 2rem 0;
  }

  .cta-portal-box {
    position: relative;
    width: 100%;
    margin: auto 0;
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 5vw, 3.5rem);
    border-radius: var(--radius-lg);
    background: rgba(18, 18, 29, 0.78);
    border: 1px solid rgba(245, 158, 11, 0.35);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    text-align: center;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6), inset 0 0 40px rgba(245, 158, 11, 0.1);
    transform: translateZ(40px);
  }

  .cta-glow-backdrop {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(245, 158, 11, 0.2), rgba(139, 92, 246, 0.15), transparent 70%);
    pointer-events: none;
  }

  .cta-title {
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .cta-desc {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.65;
    max-width: 520px;
    margin: 0 auto 2.2rem;
  }

  .footer {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    transform: translateZ(20px);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .footer-text strong {
    display: block;
    font-size: 0.95rem;
    color: var(--text);
  }

  .footer-text p {
    margin: 0;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .footer-copy {
    color: var(--muted);
    font-size: 0.82rem;
    margin: 0;
  }

  /* -----------------------------------------------------------
     12. Buttons & Atoms
     ----------------------------------------------------------- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.8rem;
    border-radius: 999px;
    font-weight: 600;
