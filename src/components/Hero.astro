<script>
  import '@google/model-viewer';
</script>

<script>
  import * as THREE from 'three';
  import Lenis from 'lenis';

  const initExperience = () => {
    const canvas = document.getElementById('web-canvas') as HTMLCanvasElement;
    const stageEl = document.getElementById('stage') as HTMLElement;
    const globalNav = document.getElementById('global-nav') as HTMLElement;
    const warpFlash = document.getElementById('warp-flash') as HTMLElement;
    const spaceHud = document.getElementById('space-hud') as HTMLElement;
    const hudAltitude = document.getElementById('hud-altitude') as HTMLElement;
    const hudGForce = document.getElementById('hud-gforce') as HTMLElement;
    const hudSector = document.getElementById('hud-sector') as HTMLElement;
    const hudReticle = document.getElementById('hud-reticle') as HTMLElement;

    const layers = Array.from(document.querySelectorAll('.layer')) as HTMLElement[];
    const trackCards = Array.from(document.querySelectorAll('.track-card')) as HTMLElement[];
    const navLinks = Array.from(document.querySelectorAll('.nav-links a')) as HTMLAnchorElement[];

    if (!canvas || !stageEl || layers.length === 0) return;

    // -----------------------------------------------------------
    // 1. Lenis Smooth Scroll Setup
    // -----------------------------------------------------------
    const lenis = new Lenis({
      duration: 1.25,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
    });

    let currentScroll = 0;
    let targetScroll = 0;
    let scrollVelocity = 0;

    lenis.on('scroll', (e) => {
      targetScroll = e.scroll;
      scrollVelocity = e.velocity || 0;
    });

    // -----------------------------------------------------------
    // 2. Mouse Tracking for Parallax, Web Magnetism & Visor HUD
    // -----------------------------------------------------------
    const mouse = { x: 0, y: 0, targetX: 0, targetY: 0, rawX: 0, rawY: 0 };
    const mouse3D = new THREE.Vector3(0, 0, 0);

    window.addEventListener('mousemove', (e) => {
      mouse.rawX = e.clientX;
      mouse.rawY = e.clientY;
      mouse.targetX = (e.clientX / window.innerWidth) * 2 - 1;
      mouse.targetY = -(e.clientY / window.innerHeight) * 2 + 1;
    });

    window.addEventListener('mouseleave', () => {
      mouse.targetX = 0;
      mouse.targetY = 0;
    });

    // -----------------------------------------------------------
    // 3. Three.js Dual-Realm: Cyber Orbit -> Deep Space Vortex
    // -----------------------------------------------------------
    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);

    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x0a0a12, 0.00055);

    const camera = new THREE.PerspectiveCamera(65, window.innerWidth / window.innerHeight, 1, 6000);
    camera.position.z = 700;

    // Procedural soft glowing circular sprite
    const createGlowTexture = () => {
      const c = document.createElement('canvas');
      c.width = 64;
      c.height = 64;
      const ctx = c.getContext('2d');
      if (ctx) {
        const grad = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
        grad.addColorStop(0, 'rgba(255, 255, 255, 1)');
        grad.addColorStop(0.2, 'rgba(168, 85, 247, 0.9)');
        grad.addColorStop(0.55, 'rgba(6, 182, 212, 0.4)');
        grad.addColorStop(1, 'rgba(10, 10, 18, 0)');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, 64, 64);
      }
      const tex = new THREE.CanvasTexture(c);
      tex.needsUpdate = true;
      return tex;
    };
    const glowTexture = createGlowTexture();

    const colorPalette = [
      new THREE.Color(0x8b5cf6), // Violet
      new THREE.Color(0xec4899), // Pink
      new THREE.Color(0x06b6d4), // Cyan
      new THREE.Color(0x38bdf8), // Sky Blue
    ];

    // ===========================================================
    // REALM 1: CYBER ORBIT (Plexus Web & Cyber Tunnel Rings)
    // ===========================================================
    const cyberGroup = new THREE.Group();

    const NODE_COUNT = 130;
    const CONNECT_DIST = 160;
    const MAX_LINES = 700;

    interface PlexusNode {
      pos: THREE.Vector3;
      basePos: THREE.Vector3;
      vel: THREE.Vector3;
      pulseOffset: number;
      color: THREE.Color;
    }

    const nodes: PlexusNode[] = [];
    const nodePositions = new Float32Array(NODE_COUNT * 3);
    const nodeColors = new Float32Array(NODE_COUNT * 3);

    for (let i = 0; i < NODE_COUNT; i++) {
      const pos = new THREE.Vector3(
        (Math.random() - 0.5) * 1700,
        (Math.random() - 0.5) * 1150,
        (Math.random() - 0.5) * 2600 - 600
      );
      const vel = new THREE.Vector3(
        (Math.random() - 0.5) * 0.45,
        (Math.random() - 0.5) * 0.45,
        (Math.random() - 0.5) * 0.35
      );
      const color = colorPalette[Math.floor(Math.random() * colorPalette.length)];

      nodes.push({
        pos,
        basePos: pos.clone(),
        vel,
        pulseOffset: Math.random() * Math.PI * 2,
        color,
      });

      nodePositions[i * 3] = pos.x;
      nodePositions[i * 3 + 1] = pos.y;
      nodePositions[i * 3 + 2] = pos.z;

      nodeColors[i * 3] = color.r;
      nodeColors[i * 3 + 1] = color.g;
      nodeColors[i * 3 + 2] = color.b;
    }

    const nodeGeometry = new THREE.BufferGeometry();
    nodeGeometry.setAttribute('position', new THREE.BufferAttribute(nodePositions, 3));
    nodeGeometry.setAttribute('color', new THREE.BufferAttribute(nodeColors, 3));

    const nodeMaterial = new THREE.PointsMaterial({
      size: 14,
      map: glowTexture,
      vertexColors: true,
      transparent: true,
      opacity: 0.95,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
    const nodePoints = new THREE.Points(nodeGeometry, nodeMaterial);
    cyberGroup.add(nodePoints);

    // Connecting Web Lines
    const linePositions = new Float32Array(MAX_LINES * 2 * 3);
    const lineColors = new Float32Array(MAX_LINES * 2 * 3);

    const lineGeometry = new THREE.BufferGeometry();
    lineGeometry.setAttribute('position', new THREE.BufferAttribute(linePositions, 3));
    lineGeometry.setAttribute('color', new THREE.BufferAttribute(lineColors, 3));

    const lineMaterial = new THREE.LineBasicMaterial({
      vertexColors: true,
      transparent: true,
      opacity: 0.85,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
    const lineSegments = new THREE.LineSegments(lineGeometry, lineMaterial);
    cyberGroup.add(lineSegments);

    // Cyber Tunnel Web Rings
    const ringDepths = [400, -200, -800, -1400, -2000, -2600];
    const ringMeshes: THREE.LineLoop[] = [];

    ringDepths.forEach((zDepth, idx) => {
      const ringGeo = new THREE.BufferGeometry();
      const segments = 24;
      const radius = 460 + idx * 30;
      const pts: number[] = [];

      for (let s = 0; s < segments; s++) {
        const theta = (s / segments) * Math.PI * 2;
        pts.push(Math.cos(theta) * radius, Math.sin(theta) * radius, 0);
      }
      ringGeo.setAttribute('position', new THREE.Float32BufferAttribute(pts, 3));

      const ringColor = idx % 2 === 0 ? 0x8b5cf6 : 0x06b6d4;
      const ringMat = new THREE.LineBasicMaterial({
        color: ringColor,
        transparent: true,
        opacity: 0.24,
        blending: THREE.AdditiveBlending,
      });

      const ring = new THREE.LineLoop(ringGeo, ringMat);
      ring.position.z = zDepth;
      ringMeshes.push(ring);
      cyberGroup.add(ring);
    });

    scene.add(cyberGroup);

    // ===========================================================
    // REALM 2: DEEP SPACE (Swirling Galactic Vortex, Nebula & Singularity)
    // ===========================================================
    const deepSpaceGroup = new THREE.Group();
    deepSpaceGroup.position.z = -1200;

    // A. Swirling Accretion Disk / Galactic Vortex (2,200 stardust particles)
    const VORTEX_COUNT = 2200;
    const vortexPositions = new Float32Array(VORTEX_COUNT * 3);
    const vortexColors = new Float32Array(VORTEX_COUNT * 3);
    const vortexData: { radius: number; angle: number; speed: number; yOffset: number }[] = [];

    const coreGold = new THREE.Color(0xffedd5); // Bright gold/white core
    const solarAmber = new THREE.Color(0xf59e0b); // Radiant Amber
    const cosmicMagenta = new THREE.Color(0xf43f5e); // Hot Pink Nebula Gas
    const outerCyan = new THREE.Color(0x06b6d4); // Deep Space Cyan

    for (let i = 0; i < VORTEX_COUNT; i++) {
      const r = 90 + Math.pow(Math.random(), 1.6) * 850;
      const angle = Math.random() * Math.PI * 2;
      // Keplerian physics: particles closer to center orbit faster
      const speed = 0.005 + (380 / (r + 120)) * 0.015;
      const yOffset = (Math.random() - 0.5) * (r * 0.16);

      vortexData.push({ radius: r, angle, speed, yOffset });

      vortexPositions[i * 3] = Math.cos(angle) * r;
      vortexPositions[i * 3 + 1] = yOffset;
      vortexPositions[i * 3 + 2] = Math.sin(angle) * r;

      const normR = Math.min(1, r / 900);
      const col = new THREE.Color();
      if (normR < 0.22) {
        col.lerpColors(coreGold, solarAmber, normR / 0.22);
      } else if (normR < 0.6) {
        col.lerpColors(solarAmber, cosmicMagenta, (normR - 0.22) / 0.38);
      } else {
        col.lerpColors(cosmicMagenta, outerCyan, (normR - 0.6) / 0.4);
      }

      vortexColors[i * 3] = col.r;
      vortexColors[i * 3 + 1] = col.g;
      vortexColors[i * 3 + 2] = col.b;
    }

    const vortexGeometry = new THREE.BufferGeometry();
    vortexGeometry.setAttribute('position', new THREE.BufferAttribute(vortexPositions, 3));
    vortexGeometry.setAttribute('color', new THREE.BufferAttribute(vortexColors, 3));

    const vortexMaterial = new THREE.PointsMaterial({
      size: 16,
      map: glowTexture,
      vertexColors: true,
      transparent: true,
      opacity: 0,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
    const vortexPoints = new THREE.Points(vortexGeometry, vortexMaterial);
    // Dramatic inclination tilt of galactic disk
    vortexPoints.rotation.x = 1.05;
    vortexPoints.rotation.y = 0.4;
    deepSpaceGroup.add(vortexPoints);

    // B. Central Singularity / Event Horizon Core
    const singularityGeo = new THREE.SphereGeometry(75, 32, 32);
    const singularityMat = new THREE.MeshBasicMaterial({ color: 0x050508 });
    const singularityMesh = new THREE.Mesh(singularityGeo, singularityMat);
    deepSpaceGroup.add(singularityMesh);

    // Glowing Corona Rings around the Singularity
    const coronaGroup = new THREE.Group();
    for (let c = 0; c < 3; c++) {
      const coronaGeo = new THREE.RingGeometry(85 + c * 30, 110 + c * 40, 32);
      const coronaMat = new THREE.MeshBasicMaterial({
        color: c === 0 ? 0xffedd5 : (c === 1 ? 0xf59e0b : 0x8b5cf6),
        side: THREE.DoubleSide,
        transparent: true,
        opacity: 0,
        blending: THREE.AdditiveBlending,
      });
      const coronaMesh = new THREE.Mesh(coronaGeo, coronaMat);
      coronaMesh.rotation.x = 1.05;
      coronaMesh.rotation.y = 0.4;
      coronaGroup.add(coronaMesh);
    }
    deepSpaceGroup.add(coronaGroup);

    // C. Deep Cosmic Nebula Gas Cloud Motes
    const NEBULA_COUNT = 550;
    const nebulaPositions = new Float32Array(NEBULA_COUNT * 3);
    const nebulaColors = new Float32Array(NEBULA_COUNT * 3);

    for (let n = 0; n < NEBULA_COUNT; n++) {
      nebulaPositions[n * 3] = (Math.random() - 0.5) * 2800;
      nebulaPositions[n * 3 + 1] = (Math.random() - 0.5) * 1900;
      nebulaPositions[n * 3 + 2] = (Math.random() - 0.5) * 2400;

      const c = colorPalette[Math.floor(Math.random() * colorPalette.length)];
      nebulaColors[n * 3] = c.r;
      nebulaColors[n * 3 + 1] = c.g;
      nebulaColors[n * 3 + 2] = c.b;
    }

    const nebulaGeometry = new THREE.BufferGeometry();
    nebulaGeometry.setAttribute('position', new THREE.BufferAttribute(nebulaPositions, 3));
    nebulaGeometry.setAttribute('color', new THREE.BufferAttribute(nebulaColors, 3));

    const nebulaMaterial = new THREE.PointsMaterial({
      size: 26,
      map: glowTexture,
      vertexColors: true,
      transparent: true,
      opacity: 0,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
    const nebulaPoints = new THREE.Points(nebulaGeometry, nebulaMaterial);
    deepSpaceGroup.add(nebulaPoints);

    scene.add(deepSpaceGroup);

    // ===========================================================
    // SHARED: Hyperspace Warp Starfield (Accelerates on scroll)
    // ===========================================================
    const STAR_COUNT = 1500;
    const starPositions = new Float32Array(STAR_COUNT * 3);
    const starColors = new Float32Array(STAR_COUNT * 3);
    const starVelocities: number[] = [];

    for (let i = 0; i < STAR_COUNT; i++) {
      starPositions[i * 3] = (Math.random() - 0.5) * 2600;
      starPositions[i * 3 + 1] = (Math.random() - 0.5) * 1800;
      starPositions[i * 3 + 2] = Math.random() * -4200 + 700;

      const starCol = colorPalette[Math.floor(Math.random() * colorPalette.length)];
      starColors[i * 3] = starCol.r;
      starColors[i * 3 + 1] = starCol.g;
      starColors[i * 3 + 2] = starCol.b;

      starVelocities.push(0.8 + Math.random() * 1.6);
    }

    const starGeometry = new THREE.BufferGeometry();
    starGeometry.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
    starGeometry.setAttribute('color', new THREE.BufferAttribute(starColors, 3));

    const starMaterial = new THREE.PointsMaterial({
      size: 11,
      map: glowTexture,
      vertexColors: true,
      transparent: true,
      opacity: 0.85,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
    const starPoints = new THREE.Points(starGeometry, starMaterial);
    scene.add(starPoints);

    // Window resize handler
    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    // -----------------------------------------------------------
    // 4. Three.js Animation Loop & Realm Cross-fading
    // -----------------------------------------------------------
    let frameTime = 0;
    let smoothProgress = 0;
    let targetProgress = 0;
    let lastActiveIndex = -1;

    const renderThree = () => {
      frameTime += 0.012;

      // Mouse Parallax on Camera
      mouse.x += (mouse.targetX - mouse.x) * 0.04;
      mouse.y += (mouse.targetY - mouse.y) * 0.04;

      camera.position.x = mouse.x * 120;
      camera.position.y = mouse.y * 80;
      camera.rotation.y = -mouse.x * 0.038;
      camera.rotation.x = mouse.y * 0.038;

      // Unproject mouse cursor plane into 3D world space
      mouse3D.set(mouse.x * 650, mouse.y * 420, 200);

      // =========================================================
      // DYNAMIC REALM SHIFT: CYBER ORBIT -> DEEP SPACE SINGULARITY
      // =========================================================
      // Transition happens between progress 1.25 and 1.95 (Entering the middle)
      const deepSpaceFactor = THREE.MathUtils.clamp((smoothProgress - 1.25) / 0.65, 0, 1);
      const cyberFactor = 1 - deepSpaceFactor;

      // Warp Flash intensity bell curve around progress 1.55
      if (warpFlash) {
        const distToWarp = Math.abs(smoothProgress - 1.55);
        if (distToWarp < 0.35) {
          const flashIntensity = Math.pow(1 - distToWarp / 0.35, 2) * 0.85;
          warpFlash.style.opacity = flashIntensity.toFixed(3);
        } else {
          warpFlash.style.opacity = '0';
        }
      }

      // Fade Cyber Group
      nodeMaterial.opacity = 0.95 * cyberFactor;
      lineMaterial.opacity = 0.85 * cyberFactor;
      ringMeshes.forEach((ring) => {
        (ring.material as THREE.LineBasicMaterial).opacity = 0.24 * cyberFactor;
      });

      // Fade Deep Space Vortex Group
      vortexMaterial.opacity = 0.96 * deepSpaceFactor;
      nebulaMaterial.opacity = 0.7 * deepSpaceFactor;
      coronaGroup.children.forEach((c, idx) => {
        ((c as THREE.Mesh).material as THREE.MeshBasicMaterial).opacity = (0.28 - idx * 0.07) * deepSpaceFactor;
      });

      // Move deep space vortex toward camera as user plunges deep
      deepSpaceGroup.position.z = -1200 + (smoothProgress - 1.3) * 320;
      deepSpaceGroup.rotation.z += 0.001;

      // Swirl the accretion disk stardust particles (Keplerian physics)
      const vPosArr = vortexGeometry.getAttribute('position').array as Float32Array;
      for (let i = 0; i < VORTEX_COUNT; i++) {
        const vd = vortexData[i];
        vd.angle += vd.speed;
        vPosArr[i * 3] = Math.cos(vd.angle) * vd.radius;
        vPosArr[i * 3 + 2] = Math.sin(vd.angle) * vd.radius;
      }
      vortexGeometry.getAttribute('position').needsUpdate = true;

      // Rotate and pulse cyber rings
      ringMeshes.forEach((ring, idx) => {
        const dir = idx % 2 === 0 ? 1 : -1;
        ring.rotation.z += 0.0025 * dir;
        const scalePulse = 1 + Math.sin(frameTime * 1.4 + idx) * 0.035;
        ring.scale.set(scalePulse, scalePulse, 1);
      });

      // Update Plexus Nodes
      const nodePosAttr = nodeGeometry.getAttribute('position') as THREE.BufferAttribute;
      const nodeArray = nodePosAttr.array as Float32Array;

      for (let i = 0; i < NODE_COUNT; i++) {
        const node = nodes[i];
        node.pos.x = node.basePos.x + Math.sin(frameTime + node.pulseOffset) * 45;
        node.pos.y = node.basePos.y + Math.cos(frameTime * 0.9 + node.pulseOffset) * 35;
        node.pos.z = node.basePos.z + Math.sin(frameTime * 0.7 + node.pulseOffset) * 40;

        // Interactive cursor magnetism
        const distToMouse = node.pos.distanceTo(mouse3D);
        if (distToMouse < 260) {
          const pullFactor = (1 - distToMouse / 260) * 0.14;
          node.pos.x += (mouse3D.x - node.pos.x) * pullFactor;
          node.pos.y += (mouse3D.y - node.pos.y) * pullFactor;
        }

        nodeArray[i * 3] = node.pos.x;
        nodeArray[i * 3 + 1] = node.pos.y;
        nodeArray[i * 3 + 2] = node.pos.z;
      }
      nodePosAttr.needsUpdate = true;

      // Update Connecting Web Lines
      const linePosAttr = lineGeometry.getAttribute('position') as THREE.BufferAttribute;
      const lineColAttr = lineGeometry.getAttribute('color') as THREE.BufferAttribute;
      const linePosArr = linePosAttr.array as Float32Array;
      const lineColArr = lineColAttr.array as Float32Array;

      let lineCount = 0;

      for (let i = 0; i < NODE_COUNT && lineCount < MAX_LINES - 45; i++) {
        for (let j = i + 1; j < NODE_COUNT && lineCount < MAX_LINES - 45; j++) {
          const p1 = nodes[i].pos;
          const p2 = nodes[j].pos;
          const dx = p1.x - p2.x;
          const dy = p1.y - p2.y;
          const dz = p1.z - p2.z;
          const distSq = dx * dx + dy * dy + dz * dz;

          if (distSq < CONNECT_DIST * CONNECT_DIST) {
            const dist = Math.sqrt(distSq);
            const alpha = Math.pow(1 - dist / CONNECT_DIST, 1.4) * 0.9 * cyberFactor;

            const idx = lineCount * 6;
            linePosArr[idx] = p1.x;
            linePosArr[idx + 1] = p1.y;
            linePosArr[idx + 2] = p1.z;

            linePosArr[idx + 3] = p2.x;
            linePosArr[idx + 4] = p2.y;
            linePosArr[idx + 5] = p2.z;

            const c1 = nodes[i].color;
            const c2 = nodes[j].color;

            lineColArr[idx] = c1.r * alpha;
            lineColArr[idx + 1] = c1.g * alpha;
            lineColArr[idx + 2] = c1.b * alpha;

            lineColArr[idx + 3] = c2.r * alpha;
            lineColArr[idx + 4] = c2.g * alpha;
            lineColArr[idx + 5] = c2.b * alpha;

            lineCount++;
          }
        }
      }

      // Interactive mouse spiderweb lines
      if ((Math.abs(mouse.targetX) > 0.01 || Math.abs(mouse.targetY) > 0.01) && cyberFactor > 0.1) {
        for (let i = 0; i < NODE_COUNT && lineCount < MAX_LINES; i++) {
          const p = nodes[i].pos;
          const distToCursor = p.distanceTo(mouse3D);
          if (distToCursor < 250) {
            const alpha = Math.pow(1 - distToCursor / 250, 1.2) * 0.95 * cyberFactor;
            const idx = lineCount * 6;

            linePosArr[idx] = p.x;
            linePosArr[idx + 1] = p.y;
            linePosArr[idx + 2] = p.z;

            linePosArr[idx + 3] = mouse3D.x;
            linePosArr[idx + 4] = mouse3D.y;
            linePosArr[idx + 5] = mouse3D.z;

            lineColArr[idx] = 0.92 * alpha;
            lineColArr[idx + 1] = 0.28 * alpha;
            lineColArr[idx + 2] = 0.95 * alpha;

            lineColArr[idx + 3] = 0.02 * alpha;
            lineColArr[idx + 4] = 0.71 * alpha;
            lineColArr[idx + 5] = 0.83 * alpha;

            lineCount++;
          }
        }
      }

      lineGeometry.setDrawRange(0, lineCount * 2);
      linePosAttr.needsUpdate = true;
      lineColAttr.needsUpdate = true;

      // Update Warp Stars (Hyperspace travel)
      const starPosAttr = starGeometry.getAttribute('position') as THREE.BufferAttribute;
      const starPosArr = starPosAttr.array as Float32Array;
      const warpSpeed = 1.2 + Math.abs(scrollVelocity) * 0.1;

      for (let i = 0; i < STAR_COUNT; i++) {
        starPosArr[i * 3 + 2] += starVelocities[i] * warpSpeed;

        if (starPosArr[i * 3 + 2] > 700) {
          starPosArr[i * 3 + 2] = -4200;
          starPosArr[i * 3] = (Math.random() - 0.5) * 2600;
          starPosArr[i * 3 + 1] = (Math.random() - 0.5) * 1800;
        }
      }
      starPosAttr.needsUpdate = true;

      renderer.render(scene, camera);
    };

    // -----------------------------------------------------------
    // 5. Distinct Spatial Transition Choreography & Astronaut HUD
    // -----------------------------------------------------------
    const updateSpatialLayers = () => {
      const scrollMax = document.documentElement.scrollHeight - window.innerHeight;
      targetProgress = scrollMax > 0 ? (currentScroll / scrollMax) * (layers.length - 1) : 0;

      // Physical momentum smoothing
      smoothProgress += (targetProgress - smoothProgress) * 0.085;

      // =========================================================
      // DYNAMIC STAGE TRANSFORMS: Barrel Roll on Hyperspace Warp Jump
      // =========================================================
      // Roll the stage during the middle hyperspace jump between Home and About
      let warpRoll = 0;
      let warpPitch = 0;
      if (smoothProgress > 0.8 && smoothProgress < 2.2) {
        const warpPhase = (smoothProgress - 0.8) / 1.4; // 0 to 1
        warpRoll = Math.sin(warpPhase * Math.PI) * -16; // 16-degree barrel roll
        warpPitch = Math.sin(warpPhase * Math.PI) * 8;
      }

      const tiltX = -mouse.y * 3.5 + warpPitch;
      const tiltY = mouse.x * 3.5;
      stageEl.style.transform = `rotateX(${tiltX.toFixed(2)}deg) rotateY(${tiltY.toFixed(2)}deg) rotateZ(${warpRoll.toFixed(2)}deg)`;

      // Persistent navigation bar
      if (globalNav) {
        if (smoothProgress > 0.35) {
          globalNav.classList.add('nav-visible');
        } else {
          globalNav.classList.remove('nav-visible');
        }
      }

      // Active nav link
      const activeIndex = Math.round(smoothProgress);
      if (activeIndex !== lastActiveIndex) {
        lastActiveIndex = activeIndex;
        navLinks.forEach((link) => {
          const target = link.getAttribute('data-target');
          if (target && parseInt(target, 10) === activeIndex) {
            link.classList.add('active');
          } else {
            link.classList.remove('active');
          }
        });
      }

      // =========================================================
      // ASTRONAUT / SHUTTLE COCKPIT HUD TELEMETRY UPDATE
      // =========================================================
      if (spaceHud) {
        // Boots up as you enter deep space (progress > 1.25)
        const hudOpacity = THREE.MathUtils.clamp((smoothProgress - 1.25) / 0.5, 0, 1);
        spaceHud.style.opacity = (hudOpacity * 0.9).toFixed(2);
        spaceHud.style.pointerEvents = hudOpacity > 0.5 ? 'auto' : 'none';

        // Real-time dynamic altitude readout
        if (hudAltitude) {
          const descentKm = Math.max(0, (4 - smoothProgress) * 12500);
          hudAltitude.textContent = `${descentKm.toLocaleString('en-US', { maximumFractionDigits: 0 })} KM`;
        }

        // Dynamic G-Force readout based on scroll acceleration
        if (hudGForce) {
          const g = Math.abs(scrollVelocity) * 0.11;
          hudGForce.textContent = `${g.toFixed(2)} G`;
        }

        // Sector name readout
        if (hudSector) {
          if (smoothProgress < 1.3) hudSector.textContent = 'SECTOR 01 // ORBITAL DEPLOY';
          else if (smoothProgress < 2.4) hudSector.textContent = 'SECTOR 02 // SUB-LIGHT NEBULA';
          else if (smoothProgress < 3.4) hudSector.textContent = 'SECTOR 03 // ZERO-G BATTLEFIELD';
          else hudSector.textContent = 'SECTOR 04 // EVENT HORIZON';
        }

        // Move Visor Targeting Reticle with mouse
        if (hudReticle) {
          hudReticle.style.transform = `translate(${mouse.rawX}px, ${mouse.rawY}px)`;
        }
      }

      // =========================================================
      // NON-REPETITIVE 3D LAYER TRANSFORMS
      // =========================================================
      layers.forEach((layer, i) => {
        const delta = smoothProgress - i;

        if (Math.abs(delta) > 1.35) {
          layer.style.opacity = '0';
          layer.style.visibility = 'hidden';
          layer.style.pointerEvents = 'none';
          return;
        }

        layer.style.visibility = 'visible';

        // -------------------------------------------------------
        // Distinct behavior for each individual layer:
        // -------------------------------------------------------
        if (i === 0) {
          // Splash: Classic forward dive
          const t = Math.max(0, delta);
          const z = t * 900;
          const blur = Math.min(16, t * 14);
          const opacity = Math.max(0, 1 - Math.pow(t / 0.85, 1.6));
          layer.style.transform = `translate3d(0, 0, ${z.toFixed(1)}px)`;
          layer.style.filter = blur > 0.2 ? `blur(${blur.toFixed(1)}px)` : 'none';
          layer.style.opacity = opacity.toFixed(3);
          layer.style.pointerEvents = delta < 0.25 ? 'auto' : 'none';
        } else if (i === 1) {
          // Home: Accelerates into the Hyperspace Jump
          if (delta < 0) {
            const u = -delta;
            const p = Math.pow(u, 1.25);
            const z = -p * 1700;
            const y = p * 40;
            const blur = Math.min(14, p * 11);
            const opacity = Math.max(0, 1 - Math.pow(u / 1.05, 1.45));
            layer.style.transform = `translate3d(0, ${y.toFixed(1)}px, ${z.toFixed(1)}px)`;
            layer.style.filter = blur > 0.2 ? `blur(${blur.toFixed(1)}px)` : 'none';
            layer.style.opacity = opacity.toFixed(3);
          } else {
            // Flies past camera with a hyperspace stretch
            const v = delta;
            const z = v * 1100;
            const blur = Math.min(18, v * 15);
            const opacity = Math.max(0, 1 - Math.pow(v / 0.78, 1.8));
            layer.style.transform = `translate3d(0, 0, ${z.toFixed(1)}px) scale(${1 + v * 0.4})`;
            layer.style.filter = blur > 0.2 ? `blur(${blur.toFixed(1)}px)` : 'none';
            layer.style.opacity = opacity.toFixed(3);
          }
          layer.style.pointerEvents = Math.abs(delta) < 0.25 ? 'auto' : 'none';
        } else if (i === 2) {
          // About: Space Station Module Docking (Rotational Deceleration Arrival)
          if (delta < 0) {
            const u = -delta;
            const p = Math.pow(u, 1.3);
            const z = -p * 1800;
            // Arrives with an orbital docking twist
            const rotZ = u * 18;
            const rotY = u * -14;
            const blur = Math.min(14, p * 11);
            const opacity = Math.max(0, 1 - Math.pow(u / 1.05, 1.45));
            layer.style.transform = `translate3d(0, 0, ${z.toFixed(1)}px) rotateZ(${rotZ.toFixed(1)}deg) rotateY(${rotY.toFixed(1)}deg)`;
            layer.style.filter = blur > 0.2 ? `blur(${blur.toFixed(1)}px)` : 'none';
            layer.style.opacity = opacity.toFixed(3);
          } else {
            const v = delta;
            const z = v * 950;
            const blur = Math.min(16, v * 13);
            const opacity = Math.max(0, 1 - Math.pow(v / 0.82, 1.6));
            layer.style.transform = `translate3d(0, 0, ${z.toFixed(1)}px)`;
            layer.style.filter = blur > 0.2 ? `blur(${blur.toFixed(1)}px)` : 'none';
            layer.style.opacity = opacity.toFixed(3);
          }
          layer.style.pointerEvents = Math.abs(delta) < 0.25 ? 'auto' : 'none';
        } else if (i === 3) {
          // Tracks: Zero-G Modular Satellite De-clustering
          if (delta < 0) {
            const u = -delta;
            const p = Math.pow(u, 1.25);
            const z = -p * 1750;
            const blur = Math.min(14, p * 11);
            const opacity = Math.max(0, 1 - Math.pow(u / 1.05, 1.45));
            layer.style.transform = `translate3d(0, 0, ${z.toFixed(1)}px)`;
            layer.style.filter = blur > 0.2 ? `blur(${blur.toFixed(1)}px)` : 'none';
            layer.style.opacity = opacity.toFixed(3);

            // Stagger 4 track cards along individual zero-gravity spatial vectors
            trackCards.forEach((card, cIdx) => {
              const dirX = cIdx % 2 === 0 ? -1 : 1;
              const dirY = cIdx < 2 ? -1 : 1;
              const cardOffset = u * 120;
              const cardRot = u * 15 * dirX;
              card.style.transform = `translate3d(${(dirX * cardOffset).toFixed(1)}px, ${(dirY * cardOffset * 0.7).toFixed(1)}px, ${(-cardOffset * 2).toFixed(1)}px) rotateY(${cardRot.toFixed(1)}deg)`;
            });
          } else {
            const v = delta;
            const z = v * 950;
            const blur = Math.min(16, v * 13);
            const opacity = Math.max(0, 1 - Math.pow(v / 0.82, 1.6));
            layer.style.transform = `translate3d(0, 0, ${z.toFixed(1)}px)`;
            layer.style.filter = blur > 0.2 ? `blur(${blur.toFixed(1)}px)` : 'none';
            layer.style.opacity = opacity.toFixed(3);

            // Disperse cards outward into deep space
            trackCards.forEach((card, cIdx) => {
              const dirX = cIdx % 2 === 0 ? -1 : 1;
              const dirY = cIdx < 2 ? -1 : 1;
              const cardOffset = v * 140;
              card.style.transform = `translate3d(${(dirX * cardOffset).toFixed(1)}px, ${(dirY * cardOffset).toFixed(1)}px, ${(v * 300).toFixed(1)}px)`;
            });
          }

          // At focal zero-G rest, cards float gently on independent sine waves
          if (Math.abs(delta) < 0.25) {
            trackCards.forEach((card, cIdx) => {
              const floatY = Math.sin(frameTime * 1.5 + cIdx * 1.2) * 6;
              const floatRot = Math.cos(frameTime * 1.2 + cIdx) * 1.2;
              card.style.transform = `translate3d(0, ${floatY.toFixed(1)}px, 0) rotateZ(${floatRot.toFixed(1)}deg)`;
            });
          }

          layer.style.pointerEvents = Math.abs(delta) < 0.25 ? 'auto' : 'none';
        } else if (i === 4) {
          // CTA: Entering the Event Horizon & Cosmic Gateway
          if (delta < 0) {
            const u = -delta;
            const p = Math.pow(u, 1.28);
            const z = -p * 1800;
            const blur = Math.min(14, p * 11);
            const opacity = Math.max(0, 1 - Math.pow(u / 1.05, 1.45));
            layer.style.transform = `translate3d(0, 0, ${z.toFixed(1)}px)`;
            layer.style.filter = blur > 0.2 ? `blur(${blur.toFixed(1)}px)` : 'none';
            layer.style.opacity = opacity.toFixed(3);
          } else {
            layer.style.transform = `translate3d(0, 0, 0)`;
            layer.style.filter = 'none';
            layer.style.opacity = '1';
          }
          layer.style.pointerEvents = Math.abs(delta) < 0.35 ? 'auto' : 'none';
        }
      });
    };

    // -----------------------------------------------------------
    // 6. Anchor Nav Link Navigation
    // -----------------------------------------------------------
    const scrollTargets: Record<string, number> = {
      '#home': 1,
      '#about': 2,
      '#tracks': 3,
      '#cta': 4,
    };

    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        const href = anchor.getAttribute('href');
        if (href && scrollTargets[href] !== undefined) {
          e.preventDefault();
          const targetIndex = scrollTargets[href];
          const scrollMax = document.documentElement.scrollHeight - window.innerHeight;
          const dest = (targetIndex / (layers.length - 1)) * scrollMax;

          lenis.scrollTo(dest, {
            duration: 1.45,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          });
        }
      });
    });

    // -----------------------------------------------------------
    // 7. Master Render Animation Loop
    // -----------------------------------------------------------
    const masterLoop = (time: number) => {
      lenis.raf(time);
      currentScroll = lenis.scroll;

      renderThree();
      updateSpatialLayers();

      requestAnimationFrame(masterLoop);
    };

    requestAnimationFrame(masterLoop);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initExperience);
  } else {
    initExperience();
  }
</script>

