---
---

<section class="cta" id="register" aria-labelledby="cta-heading">
  <div class="container cta-grid">
    <div class="cta-copy">
      <div class="rocket" aria-hidden="true">
        <svg viewBox="0 0 120 160" fill="none">
          <path d="M60 8c18 28 28 58 28 92 0 18-8 34-28 52-20-18-28-34-28-52 0-34 10-64 28-92Z" fill="#7B5CFF"/>
          <circle cx="60" cy="70" r="14" fill="#E8F7FF"/>
          <path d="M40 108c-10 4-18 14-22 28 14-2 24 0 34-8l-12-20Zm40 0 12 20c10 8 20 6 34 8-4-14-12-24-22-28l-24 0Z" fill="#FF6A3D"/>
          <path d="M52 140c4 8 8 14 8 14s4-6 8-14H52Z" fill="#FFD166"/>
        </svg>
      </div>
      <h2 id="cta-heading">We&apos;re ready to take your show to the next level!</h2>
      <p>
        Get an in-depth understanding of how Spirit X can benefit your team and
        find answers to all your questions.
      </p>
    </div>

    <form class="cta-form" method="post" action="/register">
      <label>
        <span>My first name is</span>
        <input type="text" name="firstName" autocomplete="given-name" required />
      </label>
      <label>
        <span>My last name is</span>
        <input type="text" name="lastName" autocomplete="family-name" required />
      </label>
      <label>
        <span>I study / work at</span>
        <input type="text" name="org" autocomplete="organization" required />
      </label>
      <label>
        <span>Reach me at</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label>
        <span>My phone number is</span>
        <input type="tel" name="phone" autocomplete="tel" />
      </label>
      <label>
        <span>Where did you hear about us</span>
        <select name="source">
          <option value="">Select one</option>
          <option>University society</option>
          <option>Social media</option>
          <option>Friend / teammate</option>
          <option>Other</option>
        </select>
      </label>
      <label class="full">
        <span>Message</span>
        <textarea name="message" rows="4"></textarea>
      </label>
      <div class="form-actions full">
        <button class="btn btn-solid-dark" type="submit">See us in action</button>
      </div>
    </form>
  </div>
</section>

<style>
  .cta {
    background: var(--grad-cta);
    padding-block: clamp(72px, 10vw, 120px);
  }

  .cta-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
  }

  .cta-copy {
    color: var(--color-ink);
  }

  .rocket {
    width: 96px;
    margin-bottom: var(--space-lg);
  }

  h2 {
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 600;
    line-height: 1.15;
    text-wrap: balance;
  }

  .cta-copy p {
    margin-top: var(--space-lg);
    max-width: 420px;
    font-size: var(--text-body-md);
    font-weight: 300;
    line-height: 1.5;
  }

  .cta-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: var(--radius-card);
    padding: clamp(20px, 3vw, 32px);
    backdrop-filter: blur(8px);
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  label span {
    font-size: 12px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
  }

  input,
  select,
  textarea {
    width: 100%;
    min-height: 41px;
    padding: 10px 12px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: var(--radius-none);
    background: rgba(255, 255, 255, 0.92);
    color: var(--color-primary);
  }

  input:hover,
  select:hover,
  textarea:hover {
    border-color: var(--color-accent);
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: 0;
    border-color: var(--color-focus);
    box-shadow: rgb(61, 178, 128) 0 0 1px;
  }

  .full {
    grid-column: 1 / -1;
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--space-xs);
  }

  @media (max-width: 900px) {
    .cta-grid,
    .cta-form {
      grid-template-columns: 1fr;
    }
  }
</style>
