---
---

<section class="home-teaser" aria-labelledby="teaser-heading">
  <div class="container">
    <h2 id="teaser-heading">An experience like no other</h2>
    <p>
      48 hours. 200+ hackers. 20+ universities. Spirit X is MoraSpirit&apos;s
      flagship inter-university hackathon — built by students, open to every
      undergraduate in Sri Lanka.
    </p>
    <div class="stats" aria-label="Hackathon highlights">
      <div>
        <strong>48</strong>
        <span>Hours</span>
      </div>
      <div>
        <strong>200+</strong>
        <span>Hackers</span>
      </div>
      <div>
        <strong>20+</strong>
        <span>Universities</span>
      </div>
      <div>
        <strong>5M+</strong>
        <span>Prize Pool</span>
      </div>
    </div>
    <div class="actions">
      <a class="btn btn-outline" href="/tracks">Explore Tracks</a>
      <a class="btn btn-solid" href="/register">Claim Your Pass</a>
    </div>
  </div>
</section>

<style>
  .home-teaser {
    background: var(--color-primary);
    padding-block: clamp(56px, 8vw, 96px);
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  h2 {
    color: var(--color-accent);
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 600;
    line-height: 1.15;
  }

  p {
    margin: var(--space-xl) auto 0;
    max-width: 680px;
    color: rgba(255, 255, 255, 0.88);
    font-size: var(--text-body-lg);
    font-weight: 300;
    line-height: 1.5;
  }

  .stats {
    margin: clamp(36px, 5vw, 56px) auto 0;
    max-width: 880px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .stats div {
    padding: var(--space-lg) var(--space-md);
    border: 1px solid rgba(58, 235, 219, 0.25);
    background: rgba(255, 255, 255, 0.03);
  }

  .stats strong {
    display: block;
    color: var(--color-accent);
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 600;
    line-height: 1.1;
  }

  .stats span {
    display: block;
    margin-top: 6px;
    color: rgba(255, 255, 255, 0.7);
    font-size: var(--text-body-sm);
    font-weight: 500;
  }

  .actions {
    margin-top: var(--space-xxxl);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
  }

  @media (max-width: 700px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
