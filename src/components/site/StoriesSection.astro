---
const stories = [
  {
    quote:
      "Spirit X turned our 48-hour sprint into the most immersive build experience of our degree — mentors, pressure, and a finals stage that felt bigger than campus.",
    name: "Anuki Fernando",
    role: "Past Finalist · University of Colombo",
    org: "Team Nova",
  },
  {
    quote:
      "The mentorship density is unmatched. Industry judges pushed our architecture harder than any coursework — and the energy on site is electric.",
    name: "Isuru Perera",
    role: "Mentor · Product Engineering",
    org: "Industry Partner",
  },
  {
    quote:
      "From registration to live pitch, MoraSpirit runs a student-first competition that still feels production-grade. Our sponsors got real engagement.",
    name: "Nethmi Jayasuriya",
    role: "Organizing Lead",
    org: "MoraSpirit",
  },
];
---

<section class="stories" id="stories" aria-labelledby="stories-heading">
  <div class="stories-bg" aria-hidden="true"></div>
  <div class="container stories-inner">
    <h2 id="stories-heading">What builders say about us</h2>

    <div class="stories-layout">
      <article class="story-card" id="story-card">
        <div class="avatar" aria-hidden="true">{stories[0].name.slice(0, 1)}</div>
        <blockquote>
          <p id="story-quote">&ldquo;{stories[0].quote}&rdquo;</p>
        </blockquote>
        <footer>
          <div>
            <strong id="story-name">{stories[0].name}</strong>
            <span id="story-role">{stories[0].role}</span>
          </div>
          <span class="org" id="story-org">{stories[0].org}</span>
        </footer>
      </article>

      <div class="story-rail" role="tablist" aria-label="Testimonials">
        {
          stories.map((story, index) => (
            <button
              class:list={["story-pill", { active: index === 0 }]}
              type="button"
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              data-index={index}
            >
              <strong>{story.name}</strong>
              <span>{story.role}</span>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script define:vars={{ stories }}>
  const quote = document.getElementById("story-quote");
  const name = document.getElementById("story-name");
  const role = document.getElementById("story-role");
  const org = document.getElementById("story-org");
  const pills = Array.from(document.querySelectorAll(".story-pill"));

  pills.forEach((pill) => {
    pill.addEventListener("click", () => {
      const index = Number(pill.getAttribute("data-index") || 0);
      const story = stories[index];
      if (!story || !quote || !name || !role || !org) return;
      pills.forEach((p) => {
        p.classList.toggle("active", p === pill);
        p.setAttribute("aria-selected", p === pill ? "true" : "false");
      });
      quote.textContent = `“${story.quote}”`;
      name.textContent = story.name;
      role.textContent = story.role;
      org.textContent = story.org;
    });
  });
</script>

<style>
  .stories {
    position: relative;
    padding-block: clamp(72px, 10vw, 120px);
    overflow: hidden;
    background: #101418;
  }

  .stories-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(19, 23, 26, 0.78), rgba(19, 23, 26, 0.88)),
      radial-gradient(circle at 20% 40%, rgba(58, 235, 219, 0.18), transparent 40%),
      radial-gradient(circle at 80% 60%, rgba(1, 144, 233, 0.25), transparent 45%);
  }

  .stories-inner {
    position: relative;
    z-index: 1;
  }

  h2 {
    text-align: center;
    margin-bottom: clamp(40px, 6vw, 64px);
    color: var(--color-ink);
    font-size: var(--text-heading-md);
    font-weight: 600;
  }

  .stories-layout {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-xxxl);
    align-items: stretch;
  }

  .story-card {
    background: var(--color-surface-alt);
    color: var(--color-primary);
    border-radius: var(--radius-card);
    padding: clamp(28px, 4vw, 40px);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--grad-section-alt);
    color: var(--color-ink);
    font-size: 28px;
    font-weight: 600;
  }

  blockquote p {
    font-size: var(--text-body-lg);
    font-weight: 300;
    line-height: 1.55;
  }

  .story-card footer {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    align-items: end;
  }

  .story-card strong {
    display: block;
    font-size: var(--text-body-md);
    font-weight: 600;
  }

  .story-card span {
    display: block;
    font-size: var(--text-body-sm);
    font-weight: 300;
    color: #555;
  }

  .org {
    font-weight: 600 !important;
    color: var(--color-primary) !important;
    text-align: right;
  }

  .story-rail {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .story-pill {
    text-align: left;
    border: 0;
    border-radius: 18px;
    padding: var(--space-md) var(--space-lg);
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-ink);
    cursor: pointer;
  }

  .story-pill strong {
    display: block;
    font-size: var(--text-body-sm);
    font-weight: 600;
  }

  .story-pill span {
    display: block;
    margin-top: 4px;
    font-size: 12px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.7);
  }

  .story-pill.active,
  .story-pill:hover {
    background: rgba(58, 235, 219, 0.2);
  }

  .story-pill:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (max-width: 900px) {
    .stories-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
