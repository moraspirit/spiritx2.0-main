---
const columns = [
  {
    title: "Explore",
    links: [
      { label: "About", href: "/about" },
      { label: "Tracks", href: "/tracks" },
      { label: "Experience", href: "/experience" },
      { label: "Stories", href: "/stories" },
      { label: "Register", href: "/register" },
    ],
  },
  {
    title: "Tracks",
    links: [
      { label: "AI & Autonomy", href: "/tracks" },
      { label: "Web & Mobile", href: "/tracks" },
      { label: "Spatial Tech", href: "/tracks" },
      { label: "Sustainability", href: "/tracks" },
    ],
  },
  {
    title: "Experience",
    links: [
      { label: "48-Hour Sprint", href: "/experience" },
      { label: "Mentorship", href: "/experience" },
      { label: "Live Finals", href: "/experience" },
      { label: "Prize Pool", href: "/experience" },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "About MoraSpirit", href: "/about" },
      { label: "Register", href: "/register" },
      { label: "Privacy Policy", href: "/about" },
      { label: "Terms", href: "/about" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "Stories", href: "/stories" },
      { label: "Partners", href: "/#partners" },
      { label: "FAQs", href: "/register" },
      { label: "Press Kit", href: "/about" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a class="brand" href="/">
        <span class="mark">SX</span>
        <span>Spirit X 2.0</span>
      </a>
      <p>Inter University Hackathon by MoraSpirit · University of Moratuwa</p>
    </div>

    <div class="footer-qr" aria-label="Event QR placeholder">
      <div class="qr" aria-hidden="true"></div>
      <p>See us in action</p>
    </div>
  </div>

  <div class="container footer-grid">
    {
      columns.map((col) => (
        <div>
          <h3>/ {col.title}</h3>
          <ul>
            {col.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="container footer-bottom">
    <div class="social" aria-label="Social links">
      <a href="#">YouTube</a>
      <a href="#">Instagram</a>
      <a href="#">Facebook</a>
      <a href="#">X</a>
    </div>
    <div class="badges" aria-hidden="true">
      <span>Student Run</span>
      <span>Open Entry</span>
      <span>Islandwide</span>
    </div>
    <p class="copy">&copy; 2026 MoraSpirit. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary);
    color: var(--color-ink);
    padding: 72px 0 40px;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: var(--space-xxxl);
    align-items: start;
    margin-bottom: var(--space-section);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 20px;
    font-weight: 600;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    background: var(--color-accent);
    color: var(--color-primary);
    font-size: 12px;
    font-weight: 700;
  }

  .footer-brand p {
    margin-top: var(--space-md);
    max-width: 320px;
    font-size: var(--text-body-sm);
    color: rgba(255, 255, 255, 0.75);
  }

  .footer-qr {
    text-align: center;
  }

  .qr {
    width: 96px;
    height: 96px;
    margin-inline: auto;
    background:
      linear-gradient(#fff 0 0) 0 0 / 30% 30%,
      linear-gradient(#fff 0 0) 100% 0 / 30% 30%,
      linear-gradient(#fff 0 0) 0 100% / 30% 30%,
      linear-gradient(#fff 0 0) 40% 40% / 20% 20%,
      #13171a;
    background-repeat: no-repeat;
    border: 8px solid #fff;
  }

  .footer-qr p {
    margin-top: var(--space-sm);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-xl);
    padding-bottom: var(--space-section);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  h3 {
    margin-bottom: var(--space-md);
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  a {
    font-size: var(--text-body-sm);
    font-weight: 300;
    color: rgba(255, 255, 255, 0.9);
  }

  a:hover {
    text-decoration: underline;
  }

  li + li {
    margin-top: 8px;
  }

  .footer-bottom {
    padding-top: var(--space-xxxl);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-md);
    align-items: center;
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .social a {
    font-size: 13px;
    font-weight: 500;
  }

  .badges {
    display: flex;
    gap: var(--space-sm);
    grid-column: 2;
    grid-row: 1;
  }

  .badges span {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.35);
    display: grid;
    place-items: center;
    text-align: center;
    font-size: 10px;
    font-weight: 600;
    line-height: 1.2;
    padding: 8px;
  }

  .copy {
    grid-column: 1 / -1;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.55);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-top,
    .footer-bottom {
      grid-template-columns: 1fr;
      display: grid;
    }
    .badges {
      grid-column: 1;
    }
  }
</style>
