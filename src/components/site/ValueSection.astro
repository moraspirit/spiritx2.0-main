---
---

<section class="value" id="about" aria-labelledby="value-heading">
  <div class="container">
    <h2 id="value-heading">An experience like no other</h2>
    <div class="value-copy">
      <p>
        Spirit X has established itself as the leading inter-university hackathon
        for building captivating products under pressure — 48 hours, one stage,
        no limits.
      </p>
      <p>
        We have since taken this energy to new levels with a full suite of tracks,
        mentorship, and live finals used by undergraduates across Sri Lanka.
      </p>
    </div>
    <div class="value-cta">
      <a class="btn btn-outline" href="/register">Get a Pass</a>
    </div>

    <div class="showcase" aria-label="Live event showcase">
      <div class="showcase-qr">
        <div class="qr-frame" aria-hidden="true">
          <svg viewBox="0 0 120 120" role="presentation">
            <rect width="120" height="120" fill="#fff" />
            <g fill="#13171A">
              <rect x="8" y="8" width="36" height="36" />
              <rect x="14" y="14" width="24" height="24" fill="#fff" />
              <rect x="20" y="20" width="12" height="12" />
              <rect x="76" y="8" width="36" height="36" />
              <rect x="82" y="14" width="24" height="24" fill="#fff" />
              <rect x="88" y="20" width="12" height="12" />
              <rect x="8" y="76" width="36" height="36" />
              <rect x="14" y="82" width="24" height="24" fill="#fff" />
              <rect x="20" y="88" width="12" height="12" />
              <rect x="52" y="8" width="8" height="8" />
              <rect x="68" y="8" width="8" height="8" />
              <rect x="52" y="24" width="8" height="8" />
              <rect x="60" y="40" width="8" height="8" />
              <rect x="76" y="52" width="8" height="8" />
              <rect x="92" y="60" width="8" height="8" />
              <rect x="52" y="52" width="16" height="16" />
              <rect x="76" y="76" width="12" height="12" />
              <rect x="96" y="84" width="8" height="8" />
              <rect x="52" y="84" width="8" height="8" />
              <rect x="68" y="96" width="8" height="8" />
              <rect x="100" y="100" width="12" height="12" />
            </g>
          </svg>
        </div>
        <p>Scan the code to join the fun!</p>
      </div>

      <div class="showcase-collage" aria-hidden="true">
        <div class="tile tile-a"></div>
        <div class="tile tile-b"></div>
        <div class="tile tile-c"></div>
        <div class="tile tile-d"></div>
        <div class="tile tile-e">
          <span>LIVE</span>
          <strong>Selfie Cam</strong>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .value {
    background: var(--color-primary);
    padding-block: clamp(72px, 10vw, 120px);
  }

  h2 {
    text-align: center;
    color: var(--color-accent);
    font-size: var(--text-display-lg);
    font-weight: 600;
    line-height: 1.15;
    text-wrap: balance;
  }

  .value-copy {
    margin: var(--space-xxxl) auto 0;
    max-width: 920px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xxxl);
  }

  .value-copy p {
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--text-body-lg);
    font-weight: 300;
    line-height: 1.5;
  }

  .value-cta {
    margin-top: var(--space-xxxl);
    text-align: center;
  }

  .showcase {
    margin-top: clamp(48px, 8vw, 80px);
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: var(--space-xl);
    align-items: stretch;
  }

  .showcase-qr {
    background: #0c0f12;
    border: 1px solid rgba(58, 235, 219, 0.35);
    border-radius: var(--radius-card);
    padding: var(--space-xxxl);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    box-shadow: var(--shadow-sm);
  }

  .qr-frame {
    width: min(220px, 70%);
    aspect-ratio: 1;
    background: #fff;
    padding: 12px;
  }

  .showcase-qr p {
    text-align: center;
    font-size: var(--text-body-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink);
  }

  .showcase-collage {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr 1fr;
    grid-template-rows: 1.1fr 0.9fr;
    gap: 10px;
    min-height: 360px;
  }

  .tile {
    border-radius: 18px;
    overflow: hidden;
    position: relative;
  }

  .tile-a {
    grid-column: 1 / 2;
    grid-row: 1 / 3;
    background:
      linear-gradient(160deg, rgba(19, 23, 26, 0.15), rgba(19, 23, 26, 0.55)),
      radial-gradient(circle at 30% 30%, #3aebdb, transparent 45%),
      linear-gradient(135deg, #1a4a6e, #0d1b2a);
    border: 2px solid #ff6a3d;
  }

  .tile-b {
    background: linear-gradient(145deg, #2b5876, #4e4376);
    border: 2px solid var(--color-accent);
  }

  .tile-c {
    background:
      radial-gradient(circle at 70% 30%, rgba(255, 255, 255, 0.35), transparent 40%),
      linear-gradient(160deg, #0f2027, #203a43 50%, #2c5364);
  }

  .tile-d {
    background: linear-gradient(180deg, #141e30, #243b55);
    border: 2px solid #ff6a3d;
  }

  .tile-e {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 4px;
    padding: var(--space-md);
    background: linear-gradient(160deg, #0190e9, #01ede2);
    color: var(--color-primary);
  }

  .tile-e span {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .tile-e strong {
    font-size: 18px;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .value-copy,
    .showcase {
      grid-template-columns: 1fr;
    }
    .showcase-collage {
      min-height: 280px;
    }
  }
</style>
