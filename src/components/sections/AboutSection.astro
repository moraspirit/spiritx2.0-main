---
import { MODELS } from '../../config/models';
---

<div class="layer" data-name="about" data-index="2">
  <div class="about-grid">
    <div class="about-model-box">
      <div class="model-glow-ring"></div>
      <model-viewer
        class="about-model-viewer"
        src={MODELS.logo.path}
        environment-image="neutral"
        shadow-intensity="1.3"
        camera-controls
        disable-zoom
        auto-rotate
        rotation-per-second="25deg"
        interaction-prompt="none"
        aria-label={MODELS.logo.name}
      ></model-viewer>
      <div class="model-hint">Exoplanet Relic Node // Another Earth</div>
    </div>

    <div class="about-copy">
      <p class="eyebrow"><span class="dot"></span> Inside Another Earth // Biosphere</p>
      <h2>Built by students,<br /><span class="grad">Across any world.</span></h2>
      <p class="about-desc">
        Spirit X is MoraSpirit's annual flagship hackathon hosted by the
        Media, Arts and Cultural Society of the University of Moratuwa. Open
        to every undergraduate across Sri Lanka, it's where raw human intellect meets
        uncharted planetary frontiers.
      </p>
      <ul class="about-list">
        <li>
          <div class="list-bullet"></div>
          <div>
            <strong>48 Hours of Bio-Digital Innovation</strong>
            <span>Sprint from planetary ideation to full production architecture.</span>
          </div>
        </li>
        <li>
          <div class="list-bullet"></div>
          <div>
            <strong>Veteran Interplanetary Mentors</strong>
            <span>Direct guidance from industry lead architects, founders, and innovators.</span>
          </div>
        </li>
        <li>
          <div class="list-bullet"></div>
          <div>
            <strong>Live Pitch &amp; Global Finals</strong>
            <span>Showcase your masterpiece directly in front of premier juries.</span>
          </div>
        </li>
      </ul>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#tracks">Access Solar Arena &rarr;</a>
      </div>
    </div>
  </div>
</div>

<style>
  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 4rem);
    transform-style: preserve-3d;
    will-change: transform, opacity, filter;
    backface-visibility: hidden;
    pointer-events: none;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    max-width: 1050px;
    width: 100%;
  }

  .about-model-box {
    position: relative;
    height: clamp(300px, 50vh, 480px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transform: translateZ(50px);
  }

  .model-glow-ring {
    position: absolute;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--border-glow, rgba(16, 185, 129, 0.4)), transparent 70%);
    filter: blur(40px);
    pointer-events: none;
  }

  .about-model-viewer {
    width: 100%;
    height: 100%;
    outline: none;
    pointer-events: auto;
  }

  .model-hint {
    margin-top: -1.5rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #38bdf8;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(10, 10, 18, 0.6);
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--border-glow, rgba(16, 185, 129, 0.4));
  }

  .about-copy {
    transform: translateZ(35px);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: #34d399;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
  }

  .about-copy h2 {
    font-size: clamp(1.8rem, 3.8vw, 2.8rem);
    line-height: 1.1;
    margin-bottom: 1.2rem;
  }

  .grad {
    background: var(--grad, linear-gradient(135deg, #10b981 0%, #06b6d4 50%, #f59e0b 100%));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .about-desc {
    color: var(--muted, #9a9aae);
    line-height: 1.7;
    font-size: 1.02rem;
    margin: 0 0 1.5rem;
  }

  .about-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .about-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .list-bullet {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
    margin-top: 0.45rem;
    flex-shrink: 0;
  }

  .about-list strong {
    display: block;
    color: var(--text, #f4f4f8);
    font-size: 1rem;
  }

  .about-list span {
    color: var(--muted, #9a9aae);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.8rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.96rem;
    text-decoration: none;
    cursor: pointer;
    background: var(--grad, linear-gradient(135deg, #10b981, #06b6d4));
    color: #fff;
    box-shadow: 0 8px 25px rgba(16, 185, 129, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(16, 185, 129, 0.5);
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 1.5rem;
    }
    .about-model-box {
      height: 280px;
    }
    .about-list {
      text-align: left;
    }
  }
</style>
