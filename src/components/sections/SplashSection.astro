---
import { MODELS } from '../../config/models';
---

<div class="layer" data-name="splash" data-index="0">
  <div class="splash-wrapper">
    <div class="splash-models-container">
      <div class="model-pod logo-pod">
        <model-viewer
          class="splash-model splash-logo"
          src={MODELS.logo.path}
          environment-image="neutral"
          shadow-intensity="1"
          camera-controls
          disable-zoom
          auto-rotate
          rotation-per-second="18deg"
          interaction-prompt="none"
          aria-label={MODELS.logo.name}
        ></model-viewer>
      </div>

      <div class="model-pod dancer-pod">
        <model-viewer
          class="splash-model splash-dancer"
          src={MODELS.dancer.path}
          environment-image="neutral"
          shadow-intensity="1.2"
          camera-controls
          disable-zoom
          interaction-prompt="none"
          animation-name="mixamo.com"
          autoplay
          aria-label={MODELS.dancer.name}
        ></model-viewer>
      </div>
    </div>

    <div class="splash-content">
      <div class="cyber-tag">
        <span class="pulse-dot"></span>
        <span>SPIRIT X 2.0 &bull; 2026</span>
      </div>

      <h1 class="splash-title">
        Inter University
        <span class="text-glow">Hackathon</span>
        <span class="grad">Competition 2026</span>
      </h1>

      <div class="splash-sub">
        <span class="sub-brand">MoraSpirit</span>
        <span class="sub-divider">&bull;</span>
        <span class="sub-uni">University of Moratuwa</span>
      </div>
    </div>

    <a class="scroll-hint" href="#home">
      <span class="hint-text">Ignite Space Mission</span>
      <span class="hint-chevron">&darr;</span>
    </a>
  </div>
</div>

<style>
  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 4rem);
    transform-style: preserve-3d;
    will-change: transform, opacity, filter;
    backface-visibility: hidden;
    pointer-events: none;
  }

  .splash-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
  }

  .splash-models-container {
    position: absolute;
    inset: 0;
    display: flex;
    width: 100%;
    height: 100%;
    pointer-events: auto;
  }

  .model-pod {
    flex: 1;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .splash-model {
    width: 100%;
    height: 90%;
    outline: none;
  }

  .splash-logo {
    animation: floatLogo 5s ease-in-out infinite;
  }

  @keyframes floatLogo {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-16px) rotate(1.5deg); }
  }

  .splash-content {
    position: relative;
    z-index: 2;
    max-width: 680px;
    margin-top: clamp(2rem, 8vh, 6rem);
    text-align: center;
    pointer-events: auto;
  }

  .cyber-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    background: rgba(18, 18, 29, 0.7);
    border: 1px solid var(--border-glow, rgba(139, 92, 246, 0.35));
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #c084fc;
    box-shadow: 0 0 15px rgba(139, 92, 246, 0.2);
    margin-bottom: 1.2rem;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22d3ee;
    box-shadow: 0 0 8px #22d3ee;
    animation: pulseDot 1.8s infinite;
  }

  @keyframes pulseDot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.5; }
  }

  .splash-title {
    font-size: clamp(2rem, 4.8vw, 3.8rem);
    line-height: 1.05;
    font-weight: 800;
    text-wrap: balance;
  }

  .text-glow {
    background: linear-gradient(90deg, #fff, #c084fc);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    display: inline-block;
  }

  .grad {
    background: var(--grad, linear-gradient(135deg, #8b5cf6 0%, #ec4899 50%, #06b6d4 100%));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .splash-sub {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding: 0.65rem 1.4rem;
    border-radius: 999px;
    background: rgba(14, 14, 24, 0.65);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
  }

  .splash-sub .sub-brand {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 1.15rem;
    background: var(--grad-glow, linear-gradient(90deg, #8b5cf6, #ec4899));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .splash-sub .sub-divider {
    color: var(--muted, #9a9aae);
    opacity: 0.5;
  }

  .splash-sub .sub-uni {
    color: var(--muted, #9a9aae);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .scroll-hint {
    position: relative;
    z-index: 2;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    color: var(--muted, #9a9aae);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    pointer-events: auto;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .scroll-hint:hover {
    color: #fff;
    transform: translateY(3px);
  }

  .hint-chevron {
    font-size: 1.2rem;
    color: #c084fc;
    animation: bounceChevron 1.8s infinite;
  }

  @keyframes bounceChevron {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  @media (max-width: 900px) {
    .splash-models-container {
      flex-direction: column;
    }
    .splash-logo,
    .splash-dancer {
      height: 45vh;
    }
    .splash-content {
      margin-top: 2rem;
    }
    .splash-title {
      font-size: 2.2rem;
    }
  }
</style>
