---
---

<div class="layer" data-name="cta" data-index="4">
  <div class="cta-wrapper">
    <div class="cta-portal-box">
      <div class="cta-glow-backdrop"></div>
      <div class="cyber-tag center">
        <span class="pulse-dot"></span>
        <span>SOLAR FLIGHT PASSES LIVE</span>
      </div>
      <h2 class="cta-title">Ready To Dance Under <span class="grad">The Solar Dawn?</span></h2>
      <p class="cta-desc">
        Boarding passes are officially live for undergraduates across all Sri Lankan universities.
        Crews of 1 to 4. Zero barrier to entry. Maximum cosmic glory.
      </p>
      <div class="hero-actions center-actions">
        <a class="btn btn-primary btn-large btn-glow" href="#cta">Claim Flight Pass</a>
        <a class="btn btn-ghost btn-large" href="#">Download Expedition Kit</a>
      </div>
    </div>

    <footer class="footer">
      <div class="footer-brand">
        <span class="brand-badge">SX</span>
        <div class="footer-text">
          <strong>Spirit X 2.0 &bull; MoraSpirit</strong>
          <p>University of Moratuwa, Sri Lanka</p>
        </div>
      </div>
      <p class="footer-copy">&copy; 2026 MoraSpirit. Empowering collegiate innovation across the cosmos.</p>
    </footer>
  </div>
</div>

<style>
  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 4rem);
    transform-style: preserve-3d;
    will-change: transform, opacity, filter;
    backface-visibility: hidden;
    pointer-events: none;
  }

  .cta-wrapper {
    max-width: 800px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    padding: 2rem 0;
  }

  .cta-portal-box {
    position: relative;
    width: 100%;
    margin: auto 0;
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 5vw, 3.5rem);
    border-radius: var(--radius-lg, 28px);
    background: rgba(18, 18, 29, 0.78);
    border: 1px solid var(--border-glow, rgba(245, 158, 11, 0.4));
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    text-align: center;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6), inset 0 0 40px rgba(245, 158, 11, 0.1);
    transform: translateZ(40px);
  }

  .cta-glow-backdrop {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(245, 158, 11, 0.2), rgba(139, 92, 246, 0.15), transparent 70%);
    pointer-events: none;
  }

  .cyber-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    background: rgba(18, 18, 29, 0.7);
    border: 1px solid var(--border-glow, rgba(245, 158, 11, 0.4));
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #fcd34d;
    box-shadow: 0 0 15px rgba(245, 158, 11, 0.2);
  }

  .cyber-tag.center {
    margin: 0 auto 1.4rem;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #f59e0b;
    box-shadow: 0 0 10px #f59e0b;
    animation: pulseDot 1.8s infinite;
  }

  @keyframes pulseDot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.5; }
  }

  .cta-title {
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .grad {
    background: var(--grad, linear-gradient(135deg, #f59e0b 0%, #fbbf24 45%, #38bdf8 100%));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .cta-desc {
    color: var(--muted, #9a9aae);
    font-size: 1.05rem;
    line-height: 1.65;
    max-width: 520px;
    margin: 0 auto 2.2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.8rem;
  }

  .center-actions {
    justify-content: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.8rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.96rem;
    text-decoration: none;
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s ease, border-color 0.25s ease;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--grad, linear-gradient(135deg, #f59e0b, #fbbf24));
    color: #000;
    box-shadow: 0 8px 25px rgba(245, 158, 11, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.3);
    font-weight: 700;
  }

  .btn-primary:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 12px 35px rgba(245, 158, 11, 0.6);
  }

  .btn-ghost {
    color: var(--text, #f4f4f8);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
  }

  .btn-large {
    padding: 1.1rem 2.4rem;
    font-size: 1.05rem;
  }

  .footer {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    transform: translateZ(20px);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .brand-badge {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    background: var(--grad-glow, linear-gradient(90deg, #f59e0b, #fbbf24));
    font-size: 0.78rem;
    font-weight: 800;
    color: #000;
    box-shadow: 0 0 15px rgba(245, 158, 11, 0.5);
  }

  .footer-text strong {
    display: block;
    font-size: 0.95rem;
    color: var(--text, #f4f4f8);
  }

  .footer-text p {
    margin: 0;
    color: var(--muted, #9a9aae);
    font-size: 0.82rem;
  }

  .footer-copy {
    color: var(--muted, #9a9aae);
    font-size: 0.82rem;
    margin: 0;
  }

  @media (max-width: 900px) {
    .footer {
      flex-direction: column;
      gap: 0.8rem;
      text-align: center;
    }
  }
</style>
