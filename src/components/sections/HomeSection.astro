---
---

<div class="layer" data-name="home" data-index="1">
  <div class="home-container">
    <div class="home-copy">
      <p class="eyebrow">
        <span class="dot"></span>
        Collegiate Deep Space Hackathon
      </p>
      <h1 class="main-title">
        Inter University
        <br />
        Hackathon
        <br />
        <span class="grad">Competition 2026</span>
      </h1>
      <p class="lead">
        The biggest inter-university hackathon in Sri Lanka. 48 hours, one
        stage, no limits. Launch beyond ordinary boundaries and write history across worlds.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-glow" href="#cta">Register For Mission</a>
        <a class="btn btn-ghost" href="#about">Mission Briefing</a>
      </div>
    </div>

    <div class="stats-card">
      <div class="stat">
        <span class="stat-num">48</span>
        <span class="stat-label">Hours Non-stop</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-num">200+</span>
        <span class="stat-label">Cosmic Hackers</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-num">20+</span>
        <span class="stat-label">Universities</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-num">5M+</span>
        <span class="stat-label">Prize Bounty</span>
      </div>
    </div>
  </div>
</div>

<style>
  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 4rem);
    transform-style: preserve-3d;
    will-change: transform, opacity, filter;
    backface-visibility: hidden;
    pointer-events: none;
  }

  .home-container {
    max-width: 1000px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3.5rem;
  }

  .home-copy {
    max-width: 660px;
    transform: translateZ(40px);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: #c084fc;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #06b6d4;
    box-shadow: 0 0 8px #06b6d4;
  }

  .main-title {
    font-size: clamp(2.4rem, 5.5vw, 4.4rem);
    line-height: 1.02;
    font-weight: 800;
    margin-top: 0.5rem;
  }

  .grad {
    background: var(--grad, linear-gradient(135deg, #8b5cf6 0%, #ec4899 50%, #06b6d4 100%));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lead {
    margin: 1.4rem 0 0;
    color: var(--muted, #9a9aae);
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.65;
    max-width: 35rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.8rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.8rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.96rem;
    text-decoration: none;
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s ease, border-color 0.25s ease;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--grad, linear-gradient(135deg, #8b5cf6, #ec4899));
    color: #fff;
    box-shadow: 0 8px 25px rgba(139, 92, 246, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .btn-primary:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 12px 35px rgba(236, 72, 153, 0.5);
  }

  .btn-ghost {
    color: var(--text, #f4f4f8);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
  }

  .stats-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 1.4rem 2.2rem;
    border-radius: var(--radius-md, 18px);
    background: rgba(18, 18, 29, 0.65);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
    transform: translateZ(30px);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .stat-num {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    font-weight: 800;
    background: var(--grad, linear-gradient(135deg, #8b5cf6, #ec4899));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stat-label {
    color: var(--muted, #9a9aae);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .stat-divider {
    width: 1px;
    height: 2.2rem;
    background: var(--border, rgba(255, 255, 255, 0.08));
  }

  @media (max-width: 900px) {
    .stats-card {
      flex-wrap: wrap;
      gap: 1.2rem;
      padding: 1.2rem;
      justify-content: space-around;
    }
    .stat-divider {
      display: none;
    }
  }
</style>
