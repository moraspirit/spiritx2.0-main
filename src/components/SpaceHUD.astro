---
---

<aside id="space-hud" class="space-hud" aria-label="Astronaut Flight Deck Telemetry">
  <div class="hud-top">
    <div class="hud-badge">
      <span class="hud-pulse"></span>
      <span>STS-2026 // SPIRIT X ODYSSEY</span>
    </div>
    <div id="hud-sector" class="hud-center-text">SECTOR 01 // CYBER ORBIT</div>
    <div class="hud-meta">
      <span>WARP: 4.8c</span>
      <span class="hud-sep">&bull;</span>
      <span>O2: 100%</span>
      <span class="hud-sep">&bull;</span>
      <span>06°47'N 79°54'E</span>
    </div>
  </div>

  <div class="hud-left">
    <div class="hud-bracket-top"></div>
    <div class="hud-ladder">
      <div class="ladder-label">MISSION DESCENT</div>
      <div id="hud-altitude" class="ladder-val">37,500 KM</div>
      <div class="ladder-ticks">
        <div class="tick active"><span>CYBER ORBIT</span></div>
        <div class="tick"><span>ANOTHER EARTH</span></div>
        <div class="tick"><span>SOLAR CITADEL</span></div>
        <div class="tick"><span>GATEWAY</span></div>
      </div>
    </div>
    <div class="hud-bracket-bot"></div>
  </div>

  <div class="hud-right">
    <div class="hud-bracket-top"></div>
    <div class="hud-g-meter">
      <div class="meter-label">THRUST G-LOAD</div>
      <div id="hud-gforce" class="meter-val">0.00 G</div>
      <div class="meter-bar-track">
        <div class="meter-bar-fill"></div>
      </div>
      <div class="meter-status">SYS: OPTIMAL</div>
    </div>
    <div class="hud-bracket-bot"></div>
  </div>

  <div id="hud-reticle" class="hud-reticle" aria-hidden="true">
    <div class="reticle-ring"></div>
    <div class="reticle-cross"></div>
  </div>
</aside>

<style>
  .space-hud {
    position: fixed;
    inset: 0;
    z-index: 40;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
    font-family: 'Space Grotesk', ui-monospace, monospace;
  }

  .hud-top {
    position: absolute;
    top: 5.5rem;
    left: clamp(1rem, 4vw, 4rem);
    right: clamp(1rem, 4vw, 4rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem 1rem;
    border-top: 1px solid rgba(6, 182, 212, 0.35);
    border-bottom: 1px solid rgba(139, 92, 246, 0.25);
    background: rgba(10, 10, 18, 0.45);
    backdrop-filter: blur(5px);
    font-size: 0.72rem;
    color: #38bdf8;
    letter-spacing: 0.12em;
  }

  .hud-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
  }

  .hud-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #06b6d4;
    box-shadow: 0 0 8px #06b6d4;
    animation: pulseDot 1.4s infinite;
  }

  @keyframes pulseDot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.5; }
  }

  .hud-center-text {
    font-weight: 700;
    color: #e0e7ff;
    letter-spacing: 0.15em;
  }

  .hud-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--muted, #9a9aae);
  }

  .hud-sep {
    color: #38bdf8;
    opacity: 0.5;
  }

  .hud-left,
  .hud-right {
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    width: 140px;
    display: flex;
    flex-direction: column;
    color: #38bdf8;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .hud-left {
    left: clamp(1rem, 3vw, 2.5rem);
  }

  .hud-right {
    right: clamp(1rem, 3vw, 2.5rem);
    text-align: right;
  }

  .hud-bracket-top {
    height: 12px;
    border-top: 1px solid rgba(6, 182, 212, 0.45);
    border-left: 1px solid rgba(6, 182, 212, 0.45);
  }

  .hud-right .hud-bracket-top {
    border-left: none;
    border-right: 1px solid rgba(6, 182, 212, 0.45);
  }

  .hud-bracket-bot {
    height: 12px;
    border-bottom: 1px solid rgba(6, 182, 212, 0.45);
    border-left: 1px solid rgba(6, 182, 212, 0.45);
  }

  .hud-right .hud-bracket-bot {
    border-left: none;
    border-right: 1px solid rgba(6, 182, 212, 0.45);
  }

  .hud-ladder,
  .hud-g-meter {
    padding: 0.6rem 0.4rem;
  }

  .ladder-label,
  .meter-label {
    font-size: 0.65rem;
    color: var(--muted, #9a9aae);
    font-weight: 600;
  }

  .ladder-val,
  .meter-val {
    font-size: 1.1rem;
    font-weight: 800;
    color: #f4f4f8;
    margin: 0.25rem 0 0.6rem;
  }

  .ladder-ticks {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border-left: 2px dashed rgba(6, 182, 212, 0.3);
    padding-left: 0.5rem;
  }

  .tick {
    color: var(--muted, #9a9aae);
    font-size: 0.62rem;
  }

  .tick.active {
    color: #22d3ee;
    font-weight: 700;
  }

  .meter-bar-track {
    width: 100%;
    height: 6px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 0.4rem;
  }

  .meter-bar-fill {
    width: 65%;
    height: 100%;
    background: linear-gradient(90deg, #06b6d4, #ec4899);
    border-radius: 999px;
  }

  .meter-status {
    font-size: 0.62rem;
    color: #4ade80;
  }

  .hud-reticle {
    position: fixed;
    top: 0;
    left: 0;
    width: 48px;
    height: 48px;
    margin-left: -24px;
    margin-top: -24px;
    pointer-events: none;
    transition: transform 0.06s ease-out;
    opacity: 0.45;
  }

  .reticle-ring {
    width: 100%;
    height: 100%;
    border: 1px dashed rgba(6, 182, 212, 0.5);
    border-radius: 50%;
    animation: spinReticle 12s linear infinite;
  }

  .reticle-cross {
    position: absolute;
    inset: 50%;
    width: 6px;
    height: 6px;
    transform: translate(-50%, -50%);
    background: #06b6d4;
    border-radius: 50%;
    box-shadow: 0 0 8px #06b6d4;
  }

  @keyframes spinReticle {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 900px) {
    .space-hud {
      display: none !important;
    }
  }
</style>
