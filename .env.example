# Spirit X 2.0 — public Vite env (copy to .env.local for local overrides)
# These must also be set in the Vercel project settings — `vercel deploy`
# builds remotely and .vercelignore excludes .env* files.

# FastAPI base URL from spiritx-registration_and_submission (no trailing slash)
# Example: https://api.spiritx.moraspirit.com
VITE_API_BASE_URL=

# Cloudflare Turnstile *site* key (never the secret)
VITE_TURNSTILE_SITE_KEY=

# Flip to "true" on Nov 1 (or when the API is live) and redeploy
VITE_REGISTRATION_OPEN=false
