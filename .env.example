# Spirit X 2.0 — public Vite env (copy to .env.local for local overrides)
# These must also be set in the Vercel project settings — `vercel deploy`
# builds remotely and .vercelignore excludes .env* files.

# FastAPI base URL from spiritx-registration_and_submission (no trailing slash)
# Production: https://spiritxapi.moraspirit.com
VITE_API_BASE_URL=

# Cloudflare Turnstile *site* key (never the secret)
VITE_TURNSTILE_SITE_KEY=

# Flip to "true" on Nov 1 (or when the API is live) and redeploy
VITE_REGISTRATION_OPEN=false

# Team portal on #/register: "true" shows that form after team-code login.
# The API's PROPOSALS_OPEN / PROTOTYPES_OPEN and deadlines are the real gate.
VITE_PROPOSALS_OPEN=false
VITE_PROTOTYPES_OPEN=false

# Same value as the API's PROPOSAL_DEADLINE (ISO with offset). Shown on the
# proposal form; the form switches to "closed" once it passes.
VITE_PROPOSAL_DEADLINE=2026-12-03T23:59:00+05:30
